msgid ""
"We won’t send any more reminders about items left in a cart to %s. Order "
"confirmations and other emails about your purchases are not affected."
msgstr ""
"Non invieremo più promemoria sugli articoli lasciati nel carrello a %s. Le "
"conferme d'ordine e le altre email relative ai tuoi acquisti non sono "
"interessate."

#. translators: %s: store name
#: inc/classes/core/ec_abandoned_carts.php:643
#, php-format
