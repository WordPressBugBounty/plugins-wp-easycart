msgstr ""
"Muestra las ventas de este mes frente a tu objetivo en la barra lateral de "
"administración."

#: admin/template/settings/initial-setup.php:813
msgid "Monthly sales goal"
msgstr "Objetivo de ventas mensual"

#: admin/template/settings/initial-setup.php:814
