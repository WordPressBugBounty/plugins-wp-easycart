"invece quello."

#: admin/template/settings/checkout.php:807
msgid "units"
msgstr "unità"

#: admin/template/settings/checkout.php:813
msgid "Email me when stock runs low"
msgstr "Inviami un'e-mail quando le scorte si esauriscono"

