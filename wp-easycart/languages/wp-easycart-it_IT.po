msgstr ""
"%s non ha dati del negozio a cui aggiungere le policy, quindi EasyCart le "
"stampa nella tua home page."

#. translators: %s: SEO plugin name.
#: admin/inc/wp_easycart_admin_search_ai.php:704
#, php-format
