msgstr "Objectif de ventes"

#: admin/template/settings/initial-setup.php:800
msgid "The progress meter in the EasyCart admin sidebar"
msgstr ""
"La jauge de progression dans la barre latérale de l'administration EasyCart"

#: admin/template/settings/initial-setup.php:804
msgid "Show the monthly goal meter"
msgstr "Afficher la jauge de l'objectif mensuel"

#: admin/template/settings/initial-setup.php:805
msgid "Shows this month’s sales against your goal in the admin sidebar."
msgstr ""
"Affiche les ventes du mois par rapport à votre objectif dans la barre "
"latérale de l'administration."

#: admin/template/settings/initial-setup.php:812
msgid "Monthly sales goal"
msgstr "Objectif de ventes mensuel"

#: admin/template/settings/initial-setup.php:813
msgid "The revenue you are aiming for each month, in your store currency."
msgstr ""
"Le chiffre d'affaires que vous visez chaque mois, dans la devise de votre "
"boutique."

#: admin/template/settings/initial-setup.php:827
msgid "Demo data"
msgstr "Données de démonstration"

#: admin/template/settings/initial-setup.php:828
