#: admin/template/settings/email-setup.php:867
msgid "Send account emails over SMTP"
msgstr "Envoyer les e-mails de compte via SMTP"

#: admin/template/settings/email-setup.php:898
msgid "Match what your provider lists for the port above."
msgstr ""
