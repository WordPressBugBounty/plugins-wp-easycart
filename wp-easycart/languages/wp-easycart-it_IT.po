#: admin/inc/wp_easycart_admin_upsell.php:478
msgid "Downloads in My Account"
msgstr "Download in Il mio account"

#: admin/inc/wp_easycart_admin_upsell.php:478
msgid ""
"Receipt, invoice, packing slip and gift receipt PDFs from the account page, "
"or as links in emails."
msgstr ""
"PDF di ricevuta, fattura, documento di trasporto e ricevuta regalo dalla "
"pagina dell'account, oppure come link nelle email."

#: admin/inc/wp_easycart_admin_upsell.php:479
msgid "Create orders in the admin"
msgstr "Crea ordini nell'amministrazione"

#: admin/inc/wp_easycart_admin_upsell.php:479
msgid ""
"Build an order for a phone or quote customer and send the invoice with a "
"link to pay."
msgstr ""
"Crea un ordine per un cliente telefonico o con preventivo e invia la fattura "
"con un link per pagare."

#: admin/inc/wp_easycart_admin_upsell.php:480
msgid "Invoice emails with a Pay button"
msgstr "Email di fattura con un pulsante Paga"

#: admin/inc/wp_easycart_admin_upsell.php:480
msgid ""
"Email an invoice from any order, with or without the PDF, and a button that "
