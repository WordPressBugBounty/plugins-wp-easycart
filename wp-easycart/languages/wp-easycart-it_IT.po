msgstr ""
"Restano alcune attività di avvio. Questo elenco resta su %s finché ogni "
"elemento non è completato, così non perdi nulla quando lasci questa pagina."

#: admin/template/settings/wizard/complete.php:33
msgid "Just trying it out?"
msgstr "Stai solo facendo una prova?"

#: admin/template/settings/wizard/complete.php:34
msgid ""
"Install demo products, categories and options so you can see a working store "
"immediately. Remove them any time."
msgstr ""
"Installa prodotti, categorie e opzioni demo per vedere subito un negozio "
"funzionante. Rimuovili quando vuoi."

