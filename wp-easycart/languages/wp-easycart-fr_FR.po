#: admin/template/settings/products/product-list.php:7
msgid "Product List Display"
msgstr "Affichage de la liste des produits"

#: admin/template/settings/products/product-list.php:16
msgid "Product Sorting"
msgstr "Tri des produits"

#: admin/template/settings/products/product-list.php:16
msgid ""
"Enabling this allows your customers to sort by things like price, title, and "
"rating."
msgstr ""
"L'activation de cette option permet à vos clients de trier par des éléments "
"tels que le prix, le titre et la note."

#: admin/template/settings/products/product-list.php:46
msgid "Oldest First"
msgstr "Anciens d'abord"

#: admin/template/settings/products/product-list.php:59
msgid "Product Sorting: Default Selection"
msgstr "Tri des produits: sélection par défaut"

#: admin/template/settings/products/product-list.php:59
msgid ""
"This is the default selected option when a customer first visits your store."
msgstr ""
"Il s'agit de l'option sélectionnée par défaut lorsqu'un client visite votre "
"magasin pour la première fois."

#: admin/template/settings/products/product-list.php:61
msgid "Product Sorting: Default Sorting"
msgstr "Tri des produits: tri par défaut"

#: admin/template/settings/products/product-list.php:61
msgid "Enabling this to show default sorting in the sort box."
msgstr ""
"Activer cette option pour afficher le tri par défaut dans la zone de tri."

#: admin/template/settings/products/product-list.php:63
msgid "Product Sorting: Price Low-High"
msgstr "Tri des produits: prix bas-haut"

#: admin/template/settings/products/product-list.php:63
msgid "Enabling this to show pricing low-high in the sort box."
msgstr "Activer ceci pour afficher les prix bas-élevés dans la zone de tri."

#: admin/template/settings/products/product-list.php:65
msgid "Product Sorting: Price High-Low"
msgstr "Tri des produits: prix haut-bas"

#: admin/template/settings/products/product-list.php:65
msgid "Enabling this to show pricing high-low in the sort box."
msgstr "Activer ceci pour afficher les prix haut-bas dans la zone de tri."

#: admin/template/settings/products/product-list.php:67
msgid "Product Sorting: Title A-Z"
msgstr "Tri des produits: Titre AZ"

#: admin/template/settings/products/product-list.php:67
msgid "Enabling this to show title a-z in the sort box."
msgstr "Activer ceci pour afficher le titre az dans la zone de tri."

#: admin/template/settings/products/product-list.php:69
msgid "Product Sorting: Title Z-A"
msgstr "Tri des produits: Titre ZA"

#: admin/template/settings/products/product-list.php:69
msgid "Enabling this to show title z-a in the sort box."
msgstr "Activer ceci pour afficher le titre za dans la zone de tri."

#: admin/template/settings/products/product-list.php:71
msgid "Product Sorting: Newest"
msgstr "Tri des produits: le plus récent"

#: admin/template/settings/products/product-list.php:71
msgid "Enabling this to show sort by newest in the sort box."
msgstr "Activer ceci pour afficher le tri par plus récent dans la zone de tri."

#: admin/template/settings/products/product-list.php:73
msgid "Product Sorting: Oldest"
msgstr "Tri des produits : Le plus ancien"

#: admin/template/settings/products/product-list.php:73
msgid "Enabling this to show sort by oldest in the sort box."
msgstr ""
"L'activation de cette option permet d'afficher le tri par ordre "
"chronologique dans la boîte de tri."

#: admin/template/settings/products/product-list.php:75
msgid "Product Sorting: Best Rating"
msgstr "Tri des produits: meilleure note"

#: admin/template/settings/products/product-list.php:75
msgid "Enabling this to show sort by rating in the sort box."
msgstr ""
"Activer cette option pour afficher le tri par note dans la zone de tri."

#: admin/template/settings/products/product-list.php:77
msgid "Product Sorting: Most Viewed"
msgstr "Tri des produits: les plus consultés"

#: admin/template/settings/products/product-list.php:77
msgid "Enabling this to show sort by most viewed in the sort box."
msgstr ""
"Activer cette option pour afficher le tri par plus affiché dans la zone de "
"tri."

#: admin/template/settings/products/product-list.php:79
msgid "Product Grid Type: Display Short Description"
msgstr "Type de grille de produit: Description courte d'affichage"

#: admin/template/settings/products/product-list.php:79
msgid "Enabling this will show the short description on the grid layout type."
msgstr ""
"L'activation de cette option affichera la brève description du type de "
"disposition de grille."

#: admin/template/settings/products/product-list.php:81
msgid "Product List: Show Featured Categories First"
msgstr "Liste de produits: afficher d'abord les catégories en vedette"

#: admin/template/settings/products/product-list.php:81
msgid ""
"Enabling this will show the featured categories first on the store landing "
"page."
msgstr ""
"L'activation de cette option affichera les catégories en vedette en premier "
"sur la page de destination du magasin."

#: admin/template/settings/products/product-list.php:83
msgid "Product List: Hide out of Stock"
msgstr "Liste des produits : Cacher en dehors du stock"

#: admin/template/settings/products/product-list.php:83
msgid ""
"Enabling this will hide items that are out of stock from the store, "
"disabling shows products with out of stock notice."
msgstr ""
"Si vous activez cette fonction, les articles en rupture de stock seront "
"masqués dans la boutique. Si vous la désactivez, les produits seront "
"affichés avec un avis de rupture de stock."

#: admin/template/settings/products/product-list.php:85
msgid "Product List: Keep Add to Cart Button"
msgstr "Liste des produits : Garder le bouton Ajouter au panier"

#: admin/template/settings/products/product-list.php:85
msgid ""
"Enabling this will keep the add to cart button on a product, rather than "
"switching to checkout. The view cart bar will still appear."
msgstr ""
"L'activation de cette option permet de conserver le bouton d'ajout au panier "
"sur un produit, plutôt que de passer à la caisse. La barre d'affichage du "
"panier apparaîtra toujours."

#: admin/template/settings/products/product-list.php:87
msgid "Product List: Redirect Add to Cart"
msgstr "Liste des produits : Redirect Add to Cart"

#: admin/template/settings/products/product-list.php:87
msgid ""
"Enabling this will send a customer to checkout as soon as the product is "
"added to cart from the list."
msgstr ""
"L'activation de cette option enverra le client à la caisse dès que le "
"produit sera ajouté au panier à partir de la liste."

#: admin/template/settings/products/product-store-defaults.php:8
msgid "Store Default Settings"
msgstr "Stocker les paramètres par défaut"

#: admin/template/settings/products/product-store-defaults.php:17
msgid "Store Defaults: Enable Product Paging"
msgstr "Valeurs par défaut du magasin : Activer la pagination des produits"

#: admin/template/settings/products/product-store-defaults.php:17
msgid ""
"Enabling this adds paging to the store page. Disable to show all products "
"instead."
msgstr ""
"L'activation de cette option ajoute une pagination à la page du magasin. "
"Désactivez cette option pour afficher tous les produits."

#: admin/template/settings/products/product-store-defaults.php:19
msgid "Store Defaults: Products Per Page"
msgstr "Valeurs par défaut du magasin : Produits par page"

#: admin/template/settings/products/product-store-defaults.php:19
msgid ""
"Enter a whole number here if you wish to override the products per page "
"options under the customize settings section."
msgstr ""
"Saisissez un nombre entier ici si vous souhaitez remplacer les options de "
"produits par page dans la section des paramètres personnalisés."

#: admin/template/settings/products/product-store-defaults.php:21
msgid "Store Defaults: Sidebar"
msgstr "Store Defaults : Barre latérale"

#: admin/template/settings/products/product-store-defaults.php:21
msgid "This allows you to enable a sidebar within your store."
msgstr "Cela vous permet d'activer une barre latérale dans votre boutique."

#: admin/template/settings/products/product-store-defaults.php:35
msgid "Slideout from Left"
msgstr "Diapositive de gauche"

#: admin/template/settings/products/product-store-defaults.php:39
msgid "Slideout from Right"
msgstr "Diapositive de droite"

#: admin/template/settings/products/product-store-defaults.php:45
msgid "Method: AND"
msgstr "Méthode : ET"

#: admin/template/settings/products/product-store-defaults.php:49
msgid "Method: OR"
msgstr "Méthode : OU"

#: admin/template/settings/products/product-store-defaults.php:70
msgid "Store Defaults: Sidebar Position"
msgstr "Store Defaults : Position de la barre latérale"

#: admin/template/settings/products/product-store-defaults.php:70
msgid ""
"This allows you to choose the best position for the sidebar on your store."
msgstr ""
"Cela vous permet de choisir la meilleure position pour la barre latérale sur "
"votre boutique."

#: admin/template/settings/products/product-store-defaults.php:72
msgid "Store Defaults: Enable Clear Filter Feature"
msgstr ""
"Mémoriser les valeurs par défaut : Activer la fonction de filtre d'effacement"

#: admin/template/settings/products/product-store-defaults.php:72
msgid "Enable this to show a filter clear feature in your sidebar."
msgstr ""
"Activez cette option pour afficher un filtre clair dans votre barre latérale."

#: admin/template/settings/products/product-store-defaults.php:75
msgid "Store Defaults: Enable Sidebar Locations"
msgstr ""
"Stocker les valeurs par défaut : Activer les emplacements dans la barre "
"latérale"

#: admin/template/settings/products/product-store-defaults.php:75
msgid "Enable this to show a pickup location selector in your sidebar."
msgstr ""
"Activez cette option pour afficher un sélecteur de lieu de ramassage dans "
"votre barre latérale."

#: admin/template/settings/products/product-store-defaults.php:79
msgid "Store Defaults: Enable Sidebar Search"
msgstr ""
"Mémoriser les valeurs par défaut : Activer la recherche dans la barre "
"latérale"

#: admin/template/settings/products/product-store-defaults.php:79
msgid "Enable this to show a search box in your sidebar."
msgstr ""
"Activez cette option pour afficher un champ de recherche dans votre barre "
"latérale."

#: admin/template/settings/products/product-store-defaults.php:81
msgid "Store Defaults: Enable Sidebar Category Links"
msgstr ""
"Valeurs par défaut du magasin : Activer les liens de catégorie dans la barre "
"latérale"

#: admin/template/settings/products/product-store-defaults.php:81
msgid ""
"Enable this to show simple category links that you can customize in your "
"sidebar."
