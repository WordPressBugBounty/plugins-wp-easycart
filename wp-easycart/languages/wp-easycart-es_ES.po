msgstr "Guía del importador"

#: admin/template/products/products/product-import-v2.php:100
msgid ""
"Every column explained, with the formats for images, categories, price tiers "
"and option sets."
msgstr ""
"Cada columna explicada, con los formatos para imágenes, categorías, niveles "
"de precio y conjuntos de opciones."

