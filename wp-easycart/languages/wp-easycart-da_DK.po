#: admin/template/settings/checkout/checkout-schedule.php:13
msgid "Preorder Pickup: Enable Multiple Locations"
msgstr "Afhentning af forudbestilling: Aktivér flere steder"

#: admin/template/settings/checkout/checkout-schedule.php:13
msgid ""
"Enable to allow a customer to choose their pickup location as well as "
"enabling the admin to connect products to specific locations."
msgstr ""
"Gør det muligt for en kunde at vælge afhentningssted, og gør det muligt for "
"administratoren at knytte produkter til bestemte steder."

#: admin/template/settings/checkout/checkout-schedule.php:15
msgid "Preorder Pickup: Enable Location Based Schedules"
msgstr "Afhentning af forudbestilling: Aktivér lokationsbaserede tidsplaner"

#: admin/template/settings/checkout/checkout-schedule.php:15
msgid ""
"If you enable this feature, be sure to add locations to your store "
"schedules. The purpose of this setting is to allow custom schedules by "
"location."
msgstr ""
"Hvis du aktiverer denne funktion, skal du sørge for at tilføje lokationer "
"til dine butiksskemaer. Formålet med denne indstilling er at tillade "
"tilpassede tidsplaner efter sted."

#: admin/template/settings/checkout/checkout-schedule.php:17
msgid "Preorder Pickup: Enable Location Selector"
msgstr "Afhentning af forudbestilling: Aktivér valg af placering"

#: admin/template/settings/checkout/checkout-schedule.php:17
msgid ""
"Enabling this to ask the user to select their pickup location on store load."
msgstr ""
"Hvis du aktiverer dette, bliver brugeren bedt om at vælge afhentningssted "
"ved indlæsning i butikken."

#: admin/template/settings/checkout/checkout-schedule.php:22
msgid "Show Miles"
msgstr "Vis Miles"

#: admin/template/settings/checkout/checkout-schedule.php:26
msgid "Show KMs"
msgstr "Vis KM'er"

