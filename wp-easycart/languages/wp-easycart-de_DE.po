msgid "Load minified store CSS and JavaScript"
msgstr "Minimiertes Shop-CSS und -JavaScript laden"

#: admin/template/settings/design.php:679
msgid ""
"Serves ec-store.min.css and ec-store.min.js for faster page loads. Turn off "
"if the store breaks after an update. Ignored when a custom theme folder "
"provides its own files."
msgstr ""
"Liefert ec-store.min.css und ec-store.min.js für schnellere "
"Seitenladezeiten. Deaktivieren, wenn der Shop nach einem Update nicht mehr "
"funktioniert. Wird ignoriert, wenn ein eigener Theme-Ordner seine eigenen "
"Dateien bereitstellt."

#: admin/template/settings/design.php:687
msgid "Skip the jQuery UI accordion script"
msgstr "jQuery-UI-Accordion-Skript überspringen"

#: admin/template/settings/design.php:688
msgid ""
"Stops loading jQuery UI accordion with the store scripts. Only for resolving "
"a conflict with your theme; some collapsible store panels may stop working."
msgstr ""
"Verhindert das Laden von jQuery UI Accordion mit den Shop-Skripten. Nur zur "
"Behebung eines Konflikts mit Ihrem Theme; manche einklappbaren Shop-Bereiche "
"funktionieren dann möglicherweise nicht mehr."

#: admin/template/settings/design.php:696
msgid "Skip the jQuery UI datepicker script"
msgstr "jQuery-UI-Datepicker-Skript überspringen"

