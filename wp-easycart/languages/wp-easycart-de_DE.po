"enthält."

#: admin/template/settings/integrations.php:748
msgid "Bucket region"
msgstr "Bucket-Region"

#: admin/template/settings/integrations.php:749
msgid "The AWS region the bucket was created in."
msgstr "Die AWS-Region, in der der Bucket erstellt wurde."

