msgid "Offers the admin-defined order in the sort menu."
msgstr "Tilbyder den admin-definerede rækkefølge i sorteringsmenuen."

#: admin/template/settings/products.php:497
msgid "“Price, low to high” sort option"
msgstr "Sorteringsmulighed \"Pris, lav til høj\""

#: admin/template/settings/products.php:498
msgid "Offers cheapest-first in the sort menu."
msgstr "Tilbyder billigste først i sorteringsmenuen."

#: admin/template/settings/products.php:507
msgid "“Price, high to low” sort option"
msgstr "Sorteringsmulighed \"Pris, høj til lav\""

#: admin/template/settings/products.php:508
msgid "Offers dearest-first in the sort menu."
msgstr "Tilbyder kæreste først i sorteringsmenuen."

#: admin/template/settings/products.php:517
msgid "“Title, A to Z” sort option"
msgstr "\"Titel, A til Å\" sorteringsmulighed"

#: admin/template/settings/products.php:518
msgid "Offers alphabetical order in the sort menu."
msgstr "Tilbyder alfabetisk rækkefølge i sorteringsmenuen."

#: admin/template/settings/products.php:527
msgid "“Title, Z to A” sort option"
msgstr "\"Titel, Å til A\" sorteringsmulighed"

#: admin/template/settings/products.php:528
msgid "Offers reverse alphabetical order in the sort menu."
msgstr "Tilbyder omvendt alfabetisk rækkefølge i sorteringsmenuen."

#: admin/template/settings/products.php:537
msgid "“Newest first” sort option"
msgstr "\"Nyeste først\" sorteringsmulighed"

#: admin/template/settings/products.php:538
msgid "Offers most recently added first in the sort menu."
msgstr "Tilbud senest tilføjet først i sorteringsmenuen."

#: admin/template/settings/products.php:547
msgid "“Oldest first” sort option"
msgstr "\"Ældste først\" sorteringsmulighed"

#: admin/template/settings/products.php:548
msgid "Offers longest-listed first in the sort menu."
msgstr "Tilbyder længst listede først i sorteringsmenuen."

#: admin/template/settings/products.php:557
msgid "“Best rated” sort option"
msgstr "Sorteringsmulighed for \"Bedst vurderede\""

#: admin/template/settings/products.php:558
msgid "Offers highest review rating first in the sort menu."
msgstr "Tilbyder den højeste omtalevurdering først i sorteringsmenuen."

#: admin/template/settings/products.php:567
msgid "“Most viewed” sort option"
msgstr "Sorteringsmulighed for \"Mest sete\""

#: admin/template/settings/products.php:568
msgid "Offers most-visited products first in the sort menu."
msgstr "Tilbyder de mest besøgte produkter først i sorteringsmenuen."

#: admin/template/settings/products.php:577
msgid "Short description on grid tiles"
msgstr "Kort beskrivelse på gitterfliser"

#: admin/template/settings/products.php:578
msgid ""
"Shows each product’s short description under its title in the grid layout."
msgstr ""
"Viser hvert produkts korte beskrivelse under dets titel i gitterlayoutet."

#: admin/template/settings/products.php:585
msgid "Featured categories first on the store page"
msgstr "Fremhævede kategorier først på butikssiden"

#: admin/template/settings/products.php:586
msgid ""
"Shows your featured categories above the product grid on the first page of "
"the store."
msgstr ""
"Viser dine fremhævede kategorier over produktgitteret på butikkens første "
"side."

#: admin/template/settings/products.php:594
msgid ""
"Off shows every product on one page. Page sizes are set under Settings › Per "
"page options."
msgstr ""
"Off viser alle produkter på én side. Sidestørrelser er indstillet under "
"Indstillinger › Indstillinger pr. side."

#: admin/template/settings/products.php:602
msgid ""
"Shows the per-page menu on product lists. The choices offered live under "
"Settings › Per page options."
msgstr ""
"Viser menuen pr. side på produktlister. De valg, der tilbydes live under "
"Indstillinger › Indstillinger pr. side."

#: admin/template/settings/products.php:613
msgid "Add to cart flow"
msgstr "Læg i indkøbskurven"

#: admin/template/settings/products.php:614
msgid "What happens the moment a shopper adds a product"
msgstr "Hvad sker der, når en kunde tilføjer et produkt"

#: admin/template/settings/products.php:618
msgid "Stay on the product page after adding to cart"
msgstr "Bliv på produktsiden, når du har tilføjet til indkøbskurven"

#: admin/template/settings/products.php:619
msgid "Off sends the shopper straight to the cart."
msgstr "Off sender kunden direkte til vognen."

#: admin/template/settings/products.php:626
msgid "Go straight to checkout when adding from a list"
msgstr "Gå direkte til kassen, når du tilføjer fra en liste"

#: admin/template/settings/products.php:627
msgid ""
"Adding a product from a grid or list sends the shopper to checkout "
"immediately."
msgstr ""
"Tilføjelse af et produkt fra et gitter eller en liste sender kunden til "
"kassen med det samme."

#: admin/template/settings/products.php:634
msgid "Keep the Add to cart button after adding"
msgstr "Behold knappen Tilføj til kurv efter tilføjelse"

#: admin/template/settings/products.php:635
msgid ""
"Off swaps a list product’s button to Checkout once it is in the cart. The "
"view-cart bar appears either way."
msgstr ""
"Off bytter et listeprodukts knap til kassen, når det er i kurven. View-cart-"
"linjen vises begge veje."

#: admin/template/settings/products.php:643
msgid "Quantity box beside list Add to cart buttons"
msgstr "Antal boks ved siden af liste Tilføj til kurv knapper"

#: admin/template/settings/products.php:644
msgid ""
"Lets shoppers choose how many from the grid. Only for products with no "
"options to pick."
msgstr ""
"Giver shoppere mulighed for at vælge, hvor mange fra gitteret. Kun for "
"produkter uden valgmuligheder."

#: admin/template/settings/products.php:652
msgid "One subscription per purchase"
msgstr "Et abonnement pr. køb"

#: admin/template/settings/products.php:653
msgid ""
"Removes the quantity box from subscription products so each purchase starts "
"a single subscription."
msgstr ""
"Fjerner mængdefeltet fra abonnementsprodukter, så hvert køb starter et "
"enkelt abonnement."

#: admin/template/settings/products.php:663
#: admin/template/settings/products.php:668
msgid "Store sidebar"
msgstr "Butik Sidebar"

#: admin/template/settings/products.php:664
msgid "The filter column beside the product list"
msgstr "Filterkolonnen ved siden af produktlisten"

#: admin/template/settings/products.php:669
msgid ""
"Adds a sidebar of search, category, manufacturer and option filters to the "
"store page."
msgstr ""
"Tilføjer et sidepanel med søge-, kategori-, producent- og indstillingsfiltre "
"til butikssiden."

#: admin/template/settings/products.php:676
msgid "Sidebar position"
msgstr "Sidebar position"

#: admin/template/settings/products.php:677
msgid "Fixed beside the list, or hidden behind a button that slides it in."
msgstr ""
"Fastgjort ved siden af listen eller skjult bag en knap, der skubber den ind."

#: admin/template/settings/products.php:680
msgid "Left column"
msgstr "Venstre kolonne"

#: admin/template/settings/products.php:681
msgid "Right column"
msgstr "Højre kolonne"

#: admin/template/settings/products.php:682
msgid "Slide in from the left"
msgstr "Skub ind fra venstre"

#: admin/template/settings/products.php:683
msgid "Slide in from the right"
msgstr "Skub ind fra højre"

#: admin/template/settings/products.php:691
msgid "“Clear filters” link"
msgstr "Linket \"Ryd filtre\""

#: admin/template/settings/products.php:692
msgid "Adds a link that resets every active filter at once."
msgstr "Tilføjer et link, der nulstiller alle aktive filtre på én gang."

#: admin/template/settings/products.php:701
msgid "Search box"
msgstr "Søgeboks"

#: admin/template/settings/products.php:702
msgid "A product search field at the top of the sidebar."
msgstr "Et produktsøgefelt øverst i sidepanelet."

#: admin/template/settings/products.php:710
msgid "Category links"
msgstr "Kategori links"

#: admin/template/settings/products.php:711
msgid "A simple list of category links you choose below."
msgstr "En simpel liste over kategorilinks, du vælger nedenfor."

#: admin/template/settings/products.php:720
msgid "Categories to link"
msgstr "Kategorier, der skal linkes til"

#: admin/template/settings/products.php:721
msgid ""
"Every category chosen here appears in the sidebar list. Type to find a "
"category."
msgstr ""
"Hver kategori, der er valgt her, vises på listen over sidepaneler. Skriv for "
"at finde en kategori."

#: admin/template/settings/products.php:722
#: admin/template/settings/products.php:751
msgid "Search categories…"
msgstr "Søge kategorier"

#: admin/template/settings/products.php:730
msgid "Category links above option filters"
msgstr "Kategori links over indstillingsfiltre"

#: admin/template/settings/products.php:731
msgid "Off lists the option filters first."
msgstr "Off viser indstillingsfiltrene først."

#: admin/template/settings/products.php:740
msgid "Category filter groups"
msgstr "Kategorifiltergrupper"

#: admin/template/settings/products.php:741
msgid ""
"Builds tick-box filter groups from one top-level category: its sub-"
"categories become the groups and their children the choices."
msgstr ""
"Bygger afkrydsningsfeltfiltergrupper fra en kategori på øverste niveau: dets "
"underkategorier bliver til grupperne og deres børn til valgmulighederne."

#: admin/template/settings/products.php:749
msgid "Top-level category for the filter groups"
msgstr "Topniveau kategori for filtergrupperne"

#: admin/template/settings/products.php:750
msgid ""
"Its sub-categories become groups; their sub-categories become the selectable "
"filters. Type to find the category; clear it for none."
msgstr ""
"Dens underkategorier bliver grupper; deres underkategorier bliver de "
"valgbare filtre. Skriv for at finde kategorien; ryd den for ingen."

#: admin/template/settings/products.php:759
msgid "How selections combine across groups"
msgstr "Sådan kombineres valg på tværs af grupper"

#: admin/template/settings/products.php:760
msgid ""
"“Match all” narrows results: a product must match a choice in every group "
"used. “Match any” widens them."
msgstr ""
"\"Match alle\" indsnævrer resultaterne: Et produkt skal matche et valg i "
"hver gruppe, der bruges. \"Match enhver\" udvider dem."

#: admin/template/settings/products.php:763
msgid "Match all groups"
msgstr "Match alle grupper"

#: admin/template/settings/products.php:764
msgid "Match any group"
msgstr "Match enhver gruppe"

#: admin/template/settings/products.php:773
msgid "Filter groups start"
msgstr "Filtergrupper starter"

#: admin/template/settings/products.php:774
msgid "Whether the groups load expanded or collapsed."
msgstr "Om grupperne indlæser udvidet eller sammenklappet."

#: admin/template/settings/products.php:777
msgid "All collapsed"
msgstr "Sammenfoldet"

#: admin/template/settings/products.php:778
msgid "All expanded"
msgstr "Alle udvidede"

#: admin/template/settings/products.php:779
msgid "First expanded"
msgstr "Først udvidet"

#: admin/template/settings/products.php:788
msgid "Manufacturer links"
msgstr "Producentlinks"

#: admin/template/settings/products.php:789
msgid "A simple list of manufacturer links you choose below."
msgstr "En simpel liste over producentlinks, du vælger nedenfor."

#: admin/template/settings/products.php:798
msgid "Manufacturers to link"
msgstr "Producenter til at linke"

#: admin/template/settings/products.php:799
msgid ""
"Every manufacturer chosen here appears in the sidebar list. Type to find a "
"manufacturer."
msgstr ""
"Alle producenter, der vælges her, vises på listen over sidepaneler. Skriv "
"for at finde en producent."

#: admin/template/settings/products.php:800
msgid "Search manufacturers…"
msgstr "Søg efter producenter..."

#: admin/template/settings/products.php:808
msgid "Price filter"
msgstr "Prisfilter"

#: admin/template/settings/products.php:809
msgid ""
"Lists your price ranges ( Settings › Price points ) with product counts, so "
"shoppers can narrow the store by price."
msgstr ""
"Viser dine prisklasser ( Indstillinger › Prispoint) med produkttællinger, så "
"kunderne kan indsnævre butikken efter pris."

#: admin/template/settings/products.php:817
msgid "Option filters"
msgstr "Mulighedsfiltre"

#: admin/template/settings/products.php:818
msgid ""
"Filter by option values such as size or color, using the option sets you "
"choose below."
msgstr ""
"Filtrer efter indstillingsværdier såsom størrelse eller farve ved hjælp af "
"de indstillingssæt, du vælger nedenfor."

#: admin/template/settings/products.php:827
msgid "Option sets to filter by"
msgstr "Mulighedssæt til at filtrere efter"

#: admin/template/settings/products.php:828
msgid ""
"Every option set chosen here gets its own filter block. Type to find an "
"option set."
msgstr ""
"Hvert indstillingssæt, der vælges her, får sin egen filterblok. Skriv for at "
"finde et indstillingssæt."

#: admin/template/settings/products.php:837
msgid "Pickup location selector"
msgstr "Vælger for afhentningssted"

#: admin/template/settings/products.php:838
msgid ""
"Lets shoppers filter the store to what a chosen pickup location stocks. "
"Needs pickup locations turned on under Shipping."
msgstr ""
"Giver kunderne mulighed for at filtrere udbyderen efter, hvad et valgt "
"afhentningssted har på lager. Skal have afhentningssteder slået til under "
"Forsendelse."

#: admin/template/settings/products.php:851
msgid "Pricing display"
msgstr "Pricing Display"

#: admin/template/settings/products.php:852
msgid "How prices, discounts and tiers are shown"
msgstr "Sådan vises priser, rabatter og niveauer"

#: admin/template/settings/products.php:856
msgid "Show promotion savings on each line"
msgstr "Vis kampagnebesparelser på hver linje"

#: admin/template/settings/products.php:857
msgid ""
"Prints the amount a promotion took off, on the product and on cart and order "
"lines, whenever one applies."
msgstr ""
"Udskriver det beløb, en kampagne tog afsted, på produktet og på indkøbskurv- "
"og ordrelinjer, når en af dem gælder."

#: admin/template/settings/products.php:864
msgid "Show coupon savings on each line"
msgstr "Vis rabatkuponbesparelser på hver linje"

#: admin/template/settings/products.php:865
msgid ""
"Prints the amount a coupon took off, on the product and on cart and order "
"lines, whenever one applies."
msgstr ""
"Udskriver det beløb, en kupon tog ud, på produktet og på indkøbskurv og "
"ordrelinjer, når en gælder."

#: admin/template/settings/products.php:872
msgid "Hide prices on seasonal (catalog-only) products"
msgstr "Skjul priser på sæsonbestemte (kun katalog) produkter"

#: admin/template/settings/products.php:873
msgid ""
"Products marked seasonal cannot be bought; this also removes their price."
msgstr ""
"Produkter, der er markeret som sæsonbetonede, kan ikke købes; dette fjerner "
"også deres pris."

#: admin/template/settings/products.php:880
msgid "Hide prices on inquiry products"
msgstr "Skjul priser på forespørgselsprodukter"

#: admin/template/settings/products.php:881
msgid ""
"Products that show an inquiry form instead of Add to cart also drop their "
"price."
msgstr ""
"Produkter, der viser en forespørgselsformular i stedet for Tilføj til kurv, "
"dropper også deres pris."

#: admin/template/settings/products.php:888
msgid "Show volume pricing as “as low as”"
msgstr "Vis volumenpriser som \"så lave som\""

#: admin/template/settings/products.php:889
msgid ""
"Products with price tiers show their lowest tier price in lists, prefixed "
"“as low as”."
msgstr ""
"Produkter med prisniveauer viser deres laveste pris på lister med præfikset "
"\"så lavt som\"."

#: admin/template/settings/products.php:896
msgid "Count each option combination separately for volume pricing"
msgstr "Tæl hver optionskombination separat for volumenpriser"

#: admin/template/settings/products.php:897
msgid ""
"Small shirts and large shirts reach a price tier on their own. Off adds "
"every variant of the product together."
msgstr ""
"Små skjorter og store skjorter når et prisniveau på egen hånd. Off tilføjer "
"hver variant af produktet sammen."

#: admin/template/settings/products.php:905
msgid "Show prices both with and without VAT"
msgstr "Vis priser både med og uden moms"

#: admin/template/settings/products.php:906
msgid ""
"Needs VAT enabled with prices entered inclusive of VAT; otherwise both "
"figures come out the same."
msgstr ""
"Har brug for moms aktiveret med angivne priser inklusive moms; ellers kommer "
"begge tal ud af det samme."

#: admin/template/settings/products.php:918
msgid "Stock counts, reservations and out-of-stock products"
msgstr "Lageroptællinger, reservationer og udsolgte produkter"

#: admin/template/settings/products.php:922
msgid "Show remaining stock on products"
msgstr "Vis resterende lager på produkter"

#: admin/template/settings/products.php:923
msgid ""
"Prints “N left in stock” on product pages. Turning it off hides stock levels "
"store-wide and overrides each product’s own setting; keep it on."
msgstr ""
"Udskriver \"N tilbage på lager\" på produktsider. Deaktivering skjuler "
"lagerniveauer i hele butikken og tilsidesætter hvert produkts egen "
"indstilling; behold den tændt."

#: admin/template/settings/products.php:931
msgid "Hide out-of-stock products from lists"
msgstr "Skjul udsolgte produkter fra lister"

#: admin/template/settings/products.php:932
msgid "Off keeps them listed with an out-of-stock notice."
msgstr "Off holder dem på listen med en meddelelse om, at de ikke er på lager."

#: admin/template/settings/products.php:939
msgid "Reserve stock while an item sits in a cart"
msgstr "Reserver lager, mens en vare ligger i en indkøbsvogn"

#: admin/template/settings/products.php:940
msgid ""
"Stock drops the moment a shopper adds an item, not only at purchase, and "
"returns when the reservation expires."
msgstr ""
"Lageret falder, så snart en kunde tilføjer en vare, ikke kun ved købet, og "
"returneres, når reservationen udløber."

#: admin/template/settings/products.php:947
msgid "Reservation length"
msgstr "Reservation tidsinterval længde"

#: admin/template/settings/products.php:948
msgid ""
"How long an item stays reserved after it is added to a cart, in the unit "
"below."
msgstr ""
"Hvor længe en vare forbliver reserveret, efter at den er føjet til en "
"indkøbsvogn, i enheden nedenfor."

#: admin/template/settings/products.php:958
msgid "Reservation unit"
msgstr "Reservation"

#: admin/template/settings/products.php:959
msgid "The unit the reservation length is measured in."
msgstr "Den enhed, reservationslængden måles i."

#: admin/template/settings/products.php:962
msgid "Seconds"
msgstr "Sekunder"

#: admin/template/settings/products.php:963
msgid "Minutes"
msgstr "Minutter"

#: admin/template/settings/products.php:964
msgid "Hours"
msgstr "Timer"

#: admin/template/settings/products.php:972
msgid "Let shoppers ask for a back-in-stock email"
msgstr "Lad kunder bede om en e-mail, der er tilbage på lager"

#: admin/template/settings/products.php:973
msgid ""
"Out-of-stock products get a “notify me” box. Subscribers are managed from "
"each product’s stock tab."
msgstr ""
"Udsolgte produkter får en \"underret mig \"-boks. Abonnenter administreres "
"fra hvert produkts lagerfane."

#: admin/template/settings/products.php:985
msgid "Customer reviews on product pages"
msgstr "Kundeanmeldelser på produktsider"

#: admin/template/settings/products.php:989
msgid "Only signed-in shoppers can review"
msgstr "Kun kunder, der er logget ind, kan gennemgå"

#: admin/template/settings/products.php:990
msgid "Guests see the reviews but must log in before writing one."
msgstr "Gæster ser omtalerne, men skal logge ind, før de skriver en."

#: admin/template/settings/products.php:997
msgid "Show the reviewer’s name"
msgstr "Vis anmelderens navn"

#: admin/template/settings/products.php:998
msgid "Prints the name given with each review. Off shows reviews anonymously."
msgstr ""
"Udskriver det navn, der er givet med hver anmeldelse. Off viser omtaler "
"anonymt."

#: admin/template/settings/products.php:1005
msgid "Email me when a review is submitted"
msgstr "Send mig en e-mail, når der er indsendt en omtale"

#: admin/template/settings/products.php:1006
msgid "Sends a notice to the store’s admin email so you can approve it."
msgstr ""
"Sender en meddelelse til butikkens administrator-e-mail, så du kan godkende "
"den."

#: admin/template/settings/products.php:1020
msgid "Inquiry form protection"
msgstr "Beskyttelse af forespørgselsformular"

#: admin/template/settings/products.php:1021
msgid ""
"Stops spam reaching the inquiry form on inquiry-mode products, without "
"showing shoppers a challenge"
msgstr ""
"Forhindrer spam i at nå forespørgselsformularen på produkter i "
"forespørgselstilstand uden at vise kunderne en udfordring"

#: admin/template/settings/products.php:1025
msgid "Hidden trap field on the inquiry form"
msgstr "Skjult fældefelt på forespørgselsformularen"

#: admin/template/settings/products.php:1026
msgid ""
"Adds a field only automated scripts can see. Anything that fills it in is "
"discarded. Shoppers never see or tab into it."
msgstr ""
"Tilføjer et felt, som kun automatiserede scripts kan se. Alt, hvad der "
"fylder det ud, kasseres. Shoppere ser eller taster aldrig ind i det."

#: admin/template/settings/products.php:1033
msgid "Shortest time an inquiry may take to write"
msgstr "Den korteste tid, det kan tage at skrive en forespørgsel"

#: admin/template/settings/products.php:1034
msgid ""
"Submissions that arrive sooner than this after the page loaded are refused, "
"which is how most scripted spam behaves. Set to 0 to turn the timing check "
"off."
msgstr ""
"Indsendelser, der ankommer tidligere end dette, efter at siden er indlæst, "
"afvises, hvilket er, hvordan de fleste scripted spam opfører sig. Indstil "
"til 0 for at slå timingen fra."

#: admin/template/settings/products.php:1039
msgid "seconds"
msgstr "sekunder"

#: admin/template/settings/products.php:1045
msgid "Limit how many inquiries one visitor can send"
msgstr "Begræns, hvor mange forespørgsler én besøgende kan sende"

#: admin/template/settings/products.php:1046
msgid ""
"Counts sent inquiries for an hour at a time and refuses the rest with a "
"short message. The defaults are well above normal shopper behavior."
msgstr ""
"Counts sendte forespørgsler i en time ad gangen og afviser resten med en "
"kort besked. Standardindstillingerne er et godt stykke over normal "
"shopperadfærd."

#: admin/template/settings/products.php:1053
msgid "Inquiries an hour from one internet address"
msgstr "Henvendelser en time fra en internetadresse"

#: admin/template/settings/products.php:1054
msgid ""
"Counted against a one-way hash of the address, never the address itself. Set "
"to 0 for no limit."
msgstr ""
"Tælles mod en envejs hash af adressen, aldrig selve adressen. Indstil til 0 "
"for ingen grænse."

#: admin/template/settings/products.php:1065
msgid "Inquiries an hour from one email address"
msgstr "Henvendelser en time fra en e-mailadresse"

#: admin/template/settings/products.php:1066
msgid ""
"Stops the same address being used over and over from different connections. "
"Set to 0 for no limit."
msgstr ""
"Stopper den samme adresse, der bruges igen og igen fra forskellige "
"forbindelser. Indstil til 0 for ingen grænse."

#: admin/template/settings/products.php:1077
msgid "Inquiries an hour about the same product"
msgstr "Henvendelser en time om det samme produkt"

#: admin/template/settings/products.php:1078
msgid ""
"A visitor who has already asked about a product this many times is asked to "
"wait. Set to 0 for no limit."
msgstr ""
"En besøgende, der allerede har spurgt om et produkt så mange gange, bliver "
"bedt om at vente. Indstil til 0 for ingen grænse."

#: admin/template/settings/products.php:1089
msgid "Only signed-in shoppers can send an inquiry"
msgstr "Kun kunder, der er logget ind, kan sende en forespørgsel"

#: admin/template/settings/products.php:1090
msgid ""
"Guests still see the form but are asked to sign in first. Off by default so "
"existing stores keep taking inquiries from anyone."
msgstr ""
"Gæster ser stadig formularen, men bliver bedt om at logge ind først. Slået "
"fra som standard, så eksisterende udbydere bliver ved med at tage "
"henvendelser fra alle."

#: admin/template/settings/products.php:1097
msgid "Check what the message contains"
msgstr "Tjek, hvad meddelelsen indeholder"

#: admin/template/settings/products.php:1098
msgid ""
"Applies the length, link and blocked-word rules below to the name and "
"message before anything is emailed."
msgstr ""
