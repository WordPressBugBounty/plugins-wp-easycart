#: inc/classes/core/class-wp-easycart-variants.php:873
msgid ""
"An item in your cart is no longer available in the option you chose. Please "
"remove it and choose another option."
msgstr ""
"En vare i din kurv er ikke længere tilgængelig i den valgmulighed, du "
"valgte. Fjern den, og vælg en anden valgmulighed."

#: inc/classes/core/class-wp-easycart-variants.php:876
msgid ""
"An item in your cart cannot be ordered right now. Please remove it or try "
"again later."
msgstr ""
"En vare i din kurv kan ikke bestilles lige nu. Fjern den, eller prøv igen "
"senere."

