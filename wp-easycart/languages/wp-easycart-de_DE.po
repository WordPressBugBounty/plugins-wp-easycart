msgstr "Mengenabhängige Preisstufen"

#: admin/inc/wp_easycart_admin_upsell.php:564
msgid "Buy 10 save 5%, buy 50 save 15% — tiers shown on the product page."
msgstr ""
"Kaufen Sie 10 und sparen Sie 5 %, kaufen Sie 50 und sparen Sie 15 % – die "
