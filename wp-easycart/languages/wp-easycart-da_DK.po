#: inc/classes/core/class-wp-easycart-subscription-gateway.php:206
msgid ""
"Subscriptions need Stripe: until Stripe takes your card payments, shoppers "
"see a message instead of a checkout."
msgstr ""
"Abonnementer kræver Stripe: indtil Stripe håndterer dine kortbetalinger, ser "
