msgstr "Ob die Gruppen aufgeklappt oder eingeklappt geladen werden."

#: admin/template/settings/products.php:777
msgid "All collapsed"
msgstr "Alle eingeklappt"

#: admin/template/settings/products.php:778
msgid "All expanded"
msgstr "Alle aufgeklappt"

#: admin/template/settings/products.php:779
msgid "First expanded"
msgstr "Erste aufgeklappt"

#: admin/template/settings/products.php:788
