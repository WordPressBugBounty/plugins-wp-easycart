msgid ""
"Until Stripe takes your card payments, shoppers see a message instead of a "
"checkout for subscription products."
msgstr ""
"Indtil Stripe håndterer dine kortbetalinger, ser kunderne en besked i stedet "
"for en kasse for abonnementsprodukter."

#: inc/classes/core/class-wp-easycart-subscription-gateway.php:305
msgid ""
"This subscription can't be bought online right now. Please contact us to "
"sign up."
msgstr ""
"Dette abonnement kan ikke købes online lige nu. Kontakt os for at tilmelde "
"dig."

#: inc/classes/core/class-wp-easycart-subscription-gateway.php:326
msgid "Only store staff see this note."
msgstr "Kun webshoppens personale kan se denne note."

#: inc/classes/core/class-wp-easycart-subscription-gateway.php:328
msgid ""
"Until Stripe takes your card payments, shoppers see the message below "
"instead of a checkout."
msgstr ""
"Indtil Stripe håndterer dine kortbetalinger, ser kunderne beskeden nedenfor "
"i stedet for en kasse."

#: inc/classes/core/class-wp-easycart-tax-providers.php:1163
