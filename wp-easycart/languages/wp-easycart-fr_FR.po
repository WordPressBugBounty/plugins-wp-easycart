msgstr "Numéros de facture"

#: admin/template/settings/documents.php:493
msgid ""
"Numbered invoices that never change once issued, and credit notes for refunds"
msgstr ""
"Des factures numérotées qui ne changent jamais une fois émises, et des "
"avoirs pour les remboursements"

