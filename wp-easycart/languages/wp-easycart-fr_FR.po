#: admin/template/settings/checkout/checkout-form-settings.php:27
msgid "State: Change with Country"
msgstr "État: changer avec le pays"

#: admin/template/settings/checkout/checkout-form-settings.php:27
msgid "The state box updates based on the country selected (preferred method)."
msgstr ""
"La zone d'état se met à jour en fonction du pays sélectionné (méthode "
"préférée)."

