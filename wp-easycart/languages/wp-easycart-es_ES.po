msgid "Notifications are not signed yet"
msgstr "Las notificaciones aún no están firmadas"

#: inc/classes/core/class-wp-easycart-paypal-webhooks.php:948
msgid ""
"This store registered for PayPal notifications before they were signed, so "
"it cannot tell a real one from a forged one. Securing them registers the "
"store again with its own key; payments keep working."
msgstr ""
"Esta tienda se registró para las notificaciones de PayPal antes de que se "
"firmaran, por lo que no puede distinguir una real de una falsificada. Al "
"protegerlas, la tienda se registra de nuevo con su propia clave; los pagos "
"siguen funcionando."

