msgstr "Il codice ZIP da cui spedisci."

#: admin/template/settings/tax.php:1012
msgid "Calculates US sales tax through TaxJar once a token is entered."
msgstr ""
"Calcola l'imposta sulle vendite USA tramite TaxJar una volta inserito un "
