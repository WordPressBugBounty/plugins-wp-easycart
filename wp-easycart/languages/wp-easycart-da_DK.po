msgid ""
"Enable to allow customers to enter a second line in the address on checkout."
msgstr ""
"Gør det muligt for kunder at angive en anden linje i adressen ved kassen."

#: admin/template/settings/checkout/checkout-form-settings.php:33
msgid "Enable to collect the phone number on checkout."
msgstr "Gør det muligt at indsamle telefonnummeret ved kassen."

#: admin/template/settings/checkout/checkout-form-settings.php:35
msgid "Require Phone Number"
msgstr "Telefonnummer"

#: admin/template/settings/checkout/checkout-form-settings.php:35
