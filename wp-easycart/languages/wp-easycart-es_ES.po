msgstr "ID de la API de TaxCloud"

#: admin/template/settings/tax.php:763
msgid "From your TaxCloud account."
msgstr "De tu cuenta de TaxCloud."

#: admin/template/settings/tax.php:770
msgid "TaxCloud API key"
msgstr "Clave de la API de TaxCloud"

#: admin/template/settings/tax.php:771
msgid "From your TaxCloud account. Kept private; only sent from your server."
msgstr ""
"De tu cuenta de TaxCloud. Se mantiene privada; solo se envía desde tu "
