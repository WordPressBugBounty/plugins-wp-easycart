#: admin/template/settings/payments/stripe_connect.php:361
msgid ""
"Stripe offers the ability to pay with a credit card directly on your "
"website. Adding Stripe gives your shopping cart a more professional look and "
"increases conversions."
msgstr ""
"Stripe bietet die Möglichkeit, direkt auf Ihrer Website mit einer "
"Kreditkarte zu bezahlen. Das Hinzufügen von Stripe verleiht Ihrem Warenkorb "
"ein professionelleres Aussehen und erhöht die Conversions."

#: admin/template/settings/payments/stripe_connect.php:365
msgid "Switch live account"
msgstr "Live-Konto wechseln"

#: admin/template/settings/payments/stripe_connect.php:368
msgid "Switch test account"
msgstr "Testkonto wechseln"

#: admin/template/settings/payments/stripe_connect.php:370
