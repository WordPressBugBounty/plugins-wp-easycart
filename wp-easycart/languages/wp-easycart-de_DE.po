msgstr "X (Twitter)-Teilen-Link"

#: admin/template/settings/products.php:397
msgid "Adds an X share icon to each product page."
msgstr "Fügt jeder Produktseite ein X-Teilen-Symbol hinzu."

#: admin/template/settings/products.php:404
msgid "Pinterest share link"
msgstr "Pinterest-Teilen-Link"

#: admin/template/settings/products.php:405
msgid "Adds a Pin it icon to each product page."
msgstr "Fügt jeder Produktseite ein „Pin it“-Symbol hinzu."

#: admin/template/settings/products.php:412
msgid "Email share link"
msgstr "E-Mail-Teilen-Link"

#: admin/template/settings/products.php:413
msgid "Adds a share-by-email icon to each product page."
msgstr "Fügt jeder Produktseite ein Symbol zum Teilen per E-Mail hinzu."

#: admin/template/settings/products.php:420
msgid "LinkedIn share link"
msgstr "LinkedIn-Teilen-Link"

#: admin/template/settings/products.php:421
msgid "Adds a LinkedIn share icon to each product page."
msgstr "Fügt jeder Produktseite ein LinkedIn-Teilen-Symbol hinzu."

#: admin/template/settings/products.php:429
msgid "Delicious share link"
msgstr "Delicious-Teilen-Link"

#: admin/template/settings/products.php:430
msgid ""
"Adds a Delicious bookmark icon to each product page. The service is largely "
"defunct."
msgstr ""
"Fügt jeder Produktseite ein Delicious-Lesezeichen-Symbol hinzu. Der Dienst "
"ist weitgehend eingestellt."

#: admin/template/settings/products.php:438
msgid "MySpace share link"
msgstr "MySpace-Teilen-Link"

#: admin/template/settings/products.php:439
msgid "Adds a MySpace share icon to each product page."
msgstr "Fügt jeder Produktseite ein MySpace-Teilen-Symbol hinzu."

#: admin/template/settings/products.php:447
msgid "Digg share link"
msgstr "Digg-Teilen-Link"

#: admin/template/settings/products.php:448
msgid "Adds a Digg share icon to each product page."
msgstr "Fügt jeder Produktseite ein Digg-Teilen-Symbol hinzu."

#: admin/template/settings/products.php:456
msgid "Google+ share link"
msgstr "Google+-Teilen-Link"

#: admin/template/settings/products.php:457
msgid ""
"Adds a Google+ share icon to each product page. Google+ has closed; the link "
"no longer works."
msgstr ""
"Fügt jeder Produktseite ein Google+-Teilen-Symbol hinzu. Google+ wurde "
"eingestellt; der Link funktioniert nicht mehr."

#: admin/template/settings/products.php:468
msgid "Product lists"
msgstr "Produktlisten"

#: admin/template/settings/products.php:469
msgid "The store page, category pages and other product grids"
msgstr "Die Shop-Seite, Kategorieseiten und andere Produktraster"

#: admin/template/settings/products.php:473
msgid "Sort menu"
msgstr "Sortiermenü"

#: admin/template/settings/products.php:474
msgid "Lets shoppers reorder the list by price, title, rating and more."
msgstr ""
"Lässt Kunden die Liste nach Preis, Titel, Bewertung und mehr neu sortieren."

#: admin/template/settings/products.php:481
msgid "Default sort order"
msgstr "Standard-Sortierreihenfolge"

#: admin/template/settings/products.php:482
msgid "The order products appear in until a shopper picks another."
msgstr ""
"Die Reihenfolge, in der Produkte angezeigt werden, bis ein Kunde eine andere "
"auswählt."

#: admin/template/settings/products.php:491
msgid "“Default order” sort option"
msgstr "Sortieroption „Standardreihenfolge“"

#: admin/template/settings/products.php:492
msgid "Offers the admin-defined order in the sort menu."
msgstr ""
"Bietet die vom Administrator festgelegte Reihenfolge im Sortiermenü an."

#: admin/template/settings/products.php:501
msgid "“Price, low to high” sort option"
msgstr "Sortieroption „Preis, aufsteigend“"

#: admin/template/settings/products.php:502
msgid "Offers cheapest-first in the sort menu."
msgstr "Bietet im Sortiermenü die günstigsten Produkte zuerst an."

#: admin/template/settings/products.php:511
msgid "“Price, high to low” sort option"
msgstr "Sortieroption „Preis, absteigend“"

#: admin/template/settings/products.php:512
msgid "Offers dearest-first in the sort menu."
msgstr "Bietet im Sortiermenü die teuersten Produkte zuerst an."

#: admin/template/settings/products.php:521
msgid "“Title, A to Z” sort option"
msgstr "Sortieroption „Titel, A bis Z“"

#: admin/template/settings/products.php:522
msgid "Offers alphabetical order in the sort menu."
msgstr "Bietet im Sortiermenü die alphabetische Reihenfolge an."

#: admin/template/settings/products.php:531
msgid "“Title, Z to A” sort option"
msgstr "Sortieroption „Titel, Z bis A“"

#: admin/template/settings/products.php:532
msgid "Offers reverse alphabetical order in the sort menu."
msgstr "Bietet im Sortiermenü die umgekehrt alphabetische Reihenfolge an."

#: admin/template/settings/products.php:541
msgid "“Newest first” sort option"
msgstr "Sortieroption „Neueste zuerst“"

#: admin/template/settings/products.php:542
msgid "Offers most recently added first in the sort menu."
msgstr "Bietet im Sortiermenü die zuletzt hinzugefügten Produkte zuerst an."

#: admin/template/settings/products.php:551
msgid "“Oldest first” sort option"
msgstr "Sortieroption „Älteste zuerst“"

#: admin/template/settings/products.php:552
msgid "Offers longest-listed first in the sort menu."
msgstr "Bietet im Sortiermenü die am längsten gelisteten Produkte zuerst an."

#: admin/template/settings/products.php:561
msgid "“Best rated” sort option"
msgstr "Sortieroption „Am besten bewertet“"

#: admin/template/settings/products.php:562
msgid "Offers highest review rating first in the sort menu."
msgstr "Bietet im Sortiermenü die am besten bewerteten Produkte zuerst an."

#: admin/template/settings/products.php:571
msgid "“Most viewed” sort option"
msgstr "Sortieroption „Meistgesehen“"

#: admin/template/settings/products.php:572
msgid "Offers most-visited products first in the sort menu."
msgstr "Bietet im Sortiermenü die meistbesuchten Produkte zuerst an."

#: admin/template/settings/products.php:581
msgid "Short description on grid tiles"
msgstr "Kurzbeschreibung auf den Rasterkacheln"

#: admin/template/settings/products.php:582
msgid ""
"Shows each product’s short description under its title in the grid layout."
msgstr ""
"Zeigt die Kurzbeschreibung jedes Produkts unter seinem Titel im Raster-"
"Layout an."

#: admin/template/settings/products.php:589
msgid "Featured categories first on the store page"
msgstr "Empfohlene Kategorien zuerst auf der Shop-Seite"

#: admin/template/settings/products.php:590
msgid ""
"Shows your featured categories above the product grid on the first page of "
"the store."
msgstr ""
"Zeigt Ihre empfohlenen Kategorien oberhalb des Produktrasters auf der ersten "
"Seite des Shops an."

#: admin/template/settings/products.php:598
msgid ""
"Off shows every product on one page. Page sizes are set under Settings › Per "
"page options."
msgstr ""
"„Aus“ zeigt alle Produkte auf einer Seite an. Die Seitengrößen werden unter "
"Einstellungen › Optionen pro Seite festgelegt."

#: admin/template/settings/products.php:606
msgid ""
"Shows the per-page menu on product lists. The choices offered live under "
"Settings › Per page options."
msgstr ""
"Zeigt das Menü für die Seitengröße in Produktlisten an. Die angebotenen "
"Optionen befinden sich unter Einstellungen › Optionen pro Seite."

#: admin/template/settings/products.php:617
msgid "Add to cart flow"
msgstr "Ablauf beim Hinzufügen zum Warenkorb"

#: admin/template/settings/products.php:618
msgid "What happens the moment a shopper adds a product"
msgstr "Was passiert, sobald ein Kunde ein Produkt hinzufügt"

#: admin/template/settings/products.php:622
msgid "Stay on the product page after adding to cart"
msgstr "Auf der Produktseite bleiben, nachdem zum Warenkorb hinzugefügt wurde"

#: admin/template/settings/products.php:623
msgid "Off sends the shopper straight to the cart."
msgstr "„Aus“ leitet den Kunden direkt zum Warenkorb weiter."

#: admin/template/settings/products.php:630
msgid "Go straight to checkout when adding from a list"
msgstr "Beim Hinzufügen aus einer Liste direkt zur Kasse gehen"

#: admin/template/settings/products.php:631
msgid ""
"Adding a product from a grid or list sends the shopper to checkout "
"immediately."
msgstr ""
"Das Hinzufügen eines Produkts aus einem Raster oder einer Liste führt den "
"Kunden sofort zur Kasse."

#: admin/template/settings/products.php:638
msgid "Keep the Add to cart button after adding"
msgstr "Schaltfläche „In den Warenkorb“ nach dem Hinzufügen beibehalten"

#: admin/template/settings/products.php:639
msgid ""
"Off swaps a list product’s button to Checkout once it is in the cart. The "
"view-cart bar appears either way."
msgstr ""
"„Aus“ ändert die Schaltfläche eines Listenprodukts nach dem Hinzufügen zum "
"Warenkorb in „Zur Kasse“. Die Warenkorbleiste erscheint in beiden Fällen."

#: admin/template/settings/products.php:647
msgid "Quantity box beside list Add to cart buttons"
msgstr "Mengenfeld neben den Schaltflächen „In den Warenkorb“ in Listen"

#: admin/template/settings/products.php:648
msgid ""
"Lets shoppers choose how many from the grid. Only for products with no "
"options to pick."
msgstr ""
"Ermöglicht Kunden, die Menge direkt im Raster zu wählen. Nur für Produkte "
"ohne auswählbare Optionen."

#: admin/template/settings/products.php:656
msgid "One subscription per purchase"
msgstr "Ein Abonnement pro Kauf"

#: admin/template/settings/products.php:657
msgid ""
"Removes the quantity box from subscription products so each purchase starts "
"a single subscription."
msgstr ""
"Entfernt das Mengenfeld bei Abonnementprodukten, sodass jeder Kauf ein "
"einzelnes Abonnement startet."

#: admin/template/settings/products.php:667
#: admin/template/settings/products.php:672
msgid "Store sidebar"
msgstr "Shop-Seitenleiste"

#: admin/template/settings/products.php:668
msgid "The filter column beside the product list"
msgstr "Die Filterspalte neben der Produktliste"

#: admin/template/settings/products.php:673
msgid ""
"Adds a sidebar of search, category, manufacturer and option filters to the "
"store page."
msgstr ""
"Fügt der Shop-Seite eine Seitenleiste mit Such-, Kategorie-, Hersteller- und "
"Optionsfiltern hinzu."

#: admin/template/settings/products.php:680
msgid "Sidebar position"
msgstr "Position der Seitenleiste"

#: admin/template/settings/products.php:681
msgid "Fixed beside the list, or hidden behind a button that slides it in."
msgstr ""
"Fest neben der Liste oder hinter einer Schaltfläche verborgen, die sie "
"einblendet."

#: admin/template/settings/products.php:684
msgid "Left column"
msgstr "Linke Spalte"

#: admin/template/settings/products.php:685
msgid "Right column"
msgstr "Rechte Spalte"

#: admin/template/settings/products.php:686
msgid "Slide in from the left"
msgstr "Von links einblenden"

#: admin/template/settings/products.php:687
msgid "Slide in from the right"
msgstr "Von rechts einblenden"

#: admin/template/settings/products.php:695
msgid "“Clear filters” link"
msgstr "Link „Filter zurücksetzen“"

#: admin/template/settings/products.php:696
msgid "Adds a link that resets every active filter at once."
msgstr "Fügt einen Link hinzu, der alle aktiven Filter auf einmal zurücksetzt."

#: admin/template/settings/products.php:706
msgid "A product search field at the top of the sidebar."
msgstr "Ein Produktsuchfeld oben in der Seitenleiste."

#: admin/template/settings/products.php:714
msgid "Category links"
msgstr "Kategorie-Links"

#: admin/template/settings/products.php:715
msgid "A simple list of category links you choose below."
msgstr "Eine einfache Liste von Kategorie-Links, die Sie unten auswählen."

#: admin/template/settings/products.php:724
msgid "Categories to link"
msgstr "Zu verlinkende Kategorien"

#: admin/template/settings/products.php:725
msgid ""
"Every category chosen here appears in the sidebar list. Type to find a "
"category."
msgstr ""
"Jede hier ausgewählte Kategorie erscheint in der Liste der Seitenleiste. "
"Tippen Sie, um eine Kategorie zu finden."

#: admin/template/settings/products.php:726
#: admin/template/settings/products.php:755
msgid "Search categories…"
msgstr "Kategorien suchen…"

#: admin/template/settings/products.php:734
msgid "Category links above option filters"
msgstr "Kategorie-Links über den Optionsfiltern"

#: admin/template/settings/products.php:735
msgid "Off lists the option filters first."
msgstr "„Aus“ listet zuerst die Optionsfilter auf."

#: admin/template/settings/products.php:744
msgid "Category filter groups"
msgstr "Kategorie-Filtergruppen"

#: admin/template/settings/products.php:745
msgid ""
"Builds tick-box filter groups from one top-level category: its sub-"
"categories become the groups and their children the choices."
msgstr ""
"Erstellt Filtergruppen mit Kontrollkästchen aus einer Hauptkategorie: Ihre "
"Unterkategorien werden zu den Gruppen und deren Unterkategorien zu den "
"Auswahlmöglichkeiten."

#: admin/template/settings/products.php:753
msgid "Top-level category for the filter groups"
msgstr "Hauptkategorie für die Filtergruppen"

#: admin/template/settings/products.php:754
msgid ""
"Its sub-categories become groups; their sub-categories become the selectable "
"filters. Type to find the category; clear it for none."
msgstr ""
"Ihre Unterkategorien werden zu Gruppen; deren Unterkategorien werden zu den "
"auswählbaren Filtern. Tippen Sie, um die Kategorie zu finden; leeren Sie das "
"Feld für keine."

#: admin/template/settings/products.php:763
msgid "How selections combine across groups"
msgstr "Wie sich Auswahlen über Gruppen hinweg kombinieren"

#: admin/template/settings/products.php:764
msgid ""
"“Match all” narrows results: a product must match a choice in every group "
"used. “Match any” widens them."
msgstr ""
"„Alle zutreffend“ schränkt die Ergebnisse ein: Ein Produkt muss in jeder "
"verwendeten Gruppe eine Auswahl erfüllen. „Beliebige zutreffend“ erweitert "
"sie."

#: admin/template/settings/products.php:767
msgid "Match all groups"
msgstr "Alle Gruppen zutreffend"

#: admin/template/settings/products.php:768
msgid "Match any group"
msgstr "Beliebige Gruppe zutreffend"

#: admin/template/settings/products.php:777
msgid "Filter groups start"
msgstr "Filtergruppen starten"

#: admin/template/settings/products.php:778
msgid "Whether the groups load expanded or collapsed."
msgstr "Ob die Gruppen aufgeklappt oder eingeklappt geladen werden."

#: admin/template/settings/products.php:781
msgid "All collapsed"
msgstr "Alle eingeklappt"

#: admin/template/settings/products.php:782
msgid "All expanded"
msgstr "Alle aufgeklappt"

#: admin/template/settings/products.php:783
msgid "First expanded"
msgstr "Erste aufgeklappt"

#: admin/template/settings/products.php:792
msgid "Manufacturer links"
msgstr "Hersteller-Links"

#: admin/template/settings/products.php:793
msgid "A simple list of manufacturer links you choose below."
msgstr "Eine einfache Liste von Hersteller-Links, die Sie unten auswählen."

#: admin/template/settings/products.php:802
msgid "Manufacturers to link"
msgstr "Zu verlinkende Hersteller"

#: admin/template/settings/products.php:803
msgid ""
"Every manufacturer chosen here appears in the sidebar list. Type to find a "
"manufacturer."
msgstr ""
"Jeder hier ausgewählte Hersteller erscheint in der Liste der Seitenleiste. "
"Tippen Sie, um einen Hersteller zu finden."

#: admin/template/settings/products.php:804
msgid "Search manufacturers…"
msgstr "Hersteller suchen…"

#: admin/template/settings/products.php:812
msgid "Price filter"
msgstr "Preisfilter"

#: admin/template/settings/products.php:813
msgid ""
"Lists your price ranges ( Settings › Price points ) with product counts, so "
"shoppers can narrow the store by price."
msgstr ""
"Listet Ihre Preisspannen ( Einstellungen › Preispunkte ) mit Produktanzahl "
"auf, damit Kunden den Shop nach Preis eingrenzen können."

#: admin/template/settings/products.php:822
msgid ""
"Filter by option values such as size or color, using the option sets you "
"choose below."
msgstr ""
"Filtert nach Optionswerten wie Größe oder Farbe, anhand der unten "
"ausgewählten Optionssätze."

#: admin/template/settings/products.php:831
msgid "Option sets to filter by"
msgstr "Optionssätze zum Filtern"

#: admin/template/settings/products.php:832
msgid ""
"Every option set chosen here gets its own filter block. Type to find an "
"option set."
msgstr ""
"Jeder hier ausgewählte Optionssatz erhält einen eigenen Filterblock. Tippen "
"Sie, um einen Optionssatz zu finden."

#: admin/template/settings/products.php:841
msgid "Pickup location selector"
msgstr "Auswahl der Abholstelle"

#: admin/template/settings/products.php:842
msgid ""
"Lets shoppers filter the store to what a chosen pickup location stocks. "
"Needs pickup locations turned on under Shipping."
msgstr ""
"Ermöglicht Kunden, den Shop nach dem Bestand einer ausgewählten Abholstelle "
"zu filtern. Erfordert aktivierte Abholstellen unter Versand."

#: admin/template/settings/products.php:855
msgid "Pricing display"
msgstr "Preisanzeige"

#: admin/template/settings/products.php:856
msgid "How prices, discounts and tiers are shown"
msgstr "Wie Preise, Rabatte und Staffeln angezeigt werden"

#: admin/template/settings/products.php:860
msgid "Show promotion savings on each line"
msgstr "Ersparnis durch Aktionen in jeder Zeile anzeigen"

#: admin/template/settings/products.php:861
msgid ""
"Prints the amount a promotion took off, on the product and on cart and order "
"lines, whenever one applies."
msgstr ""
"Zeigt den durch eine Aktion abgezogenen Betrag auf dem Produkt sowie in "
"Warenkorb- und Bestellzeilen an, sobald eine Aktion gilt."

#: admin/template/settings/products.php:868
msgid "Show coupon savings on each line"
msgstr "Ersparnis durch Gutscheine in jeder Zeile anzeigen"

#: admin/template/settings/products.php:869
msgid ""
"Prints the amount a coupon took off, on the product and on cart and order "
"lines, whenever one applies."
msgstr ""
"Zeigt den durch einen Gutschein abgezogenen Betrag auf dem Produkt sowie in "
"Warenkorb- und Bestellzeilen an, sobald einer gilt."

#: admin/template/settings/products.php:876
msgid "Hide prices on seasonal (catalog-only) products"
msgstr "Preise bei saisonalen Produkten (nur Katalog) ausblenden"

#: admin/template/settings/products.php:877
msgid ""
"Products marked seasonal cannot be bought; this also removes their price."
msgstr ""
"Als saisonal markierte Produkte können nicht gekauft werden; dadurch "
"entfällt auch die Preisanzeige."

#: admin/template/settings/products.php:884
msgid "Hide prices on inquiry products"
msgstr "Preise bei Anfrageprodukten ausblenden"

#: admin/template/settings/products.php:885
msgid ""
"Products that show an inquiry form instead of Add to cart also drop their "
"price."
msgstr ""
"Produkte, die statt „In den Warenkorb“ ein Anfrageformular anzeigen, "
"verlieren ebenfalls ihre Preisanzeige."

#: admin/template/settings/products.php:892
msgid "Show volume pricing as “as low as”"
msgstr "Staffelpreise als „ab“ anzeigen"

#: admin/template/settings/products.php:893
msgid ""
"Products with price tiers show their lowest tier price in lists, prefixed "
"“as low as”."
msgstr ""
"Produkte mit Preisstaffeln zeigen in Listen ihren niedrigsten Staffelpreis "
"mit dem Zusatz „ab“ an."

#: admin/template/settings/products.php:900
msgid "Count each option combination separately for volume pricing"
msgstr "Jede Optionskombination für Staffelpreise separat zählen"

#: admin/template/settings/products.php:901
msgid ""
"Small shirts and large shirts reach a price tier on their own. Off adds "
"every variant of the product together."
msgstr ""
"Kleine und große Shirts erreichen eine Preisstaffel jeweils für sich. „Aus“ "
"zählt alle Varianten des Produkts zusammen."

#: admin/template/settings/products.php:909
msgid "Show prices both with and without VAT"
msgstr "Preise sowohl mit als auch ohne MwSt. anzeigen"

#: admin/template/settings/products.php:910
msgid ""
"Needs VAT enabled with prices entered inclusive of VAT; otherwise both "
"figures come out the same."
msgstr ""
"Erfordert aktivierte MwSt. mit Preisen, die inklusive MwSt. eingegeben "
"wurden; andernfalls sind beide Beträge gleich."

#: admin/template/settings/products.php:922
msgid "Stock counts, reservations and out-of-stock products"
msgstr "Bestandszahlen, Reservierungen und nicht vorrätige Produkte"

#: admin/template/settings/products.php:926
msgid "Show remaining stock on products"
msgstr "Verbleibenden Bestand bei Produkten anzeigen"

#: admin/template/settings/products.php:927
msgid ""
"Prints “N left in stock” on product pages. Turning it off hides stock levels "
"store-wide and overrides each product’s own setting; keep it on."
msgstr ""
"Zeigt „Noch N auf Lager“ auf Produktseiten an. Das Deaktivieren blendet den "
"Lagerbestand im gesamten Shop aus und überschreibt die jeweilige Einstellung "
"des Produkts; lassen Sie es aktiviert."

#: admin/template/settings/products.php:935
msgid "Hide out-of-stock products from lists"
msgstr "Nicht vorrätige Produkte aus Listen ausblenden"

#: admin/template/settings/products.php:936
msgid "Off keeps them listed with an out-of-stock notice."
msgstr "„Aus“ behält sie mit einem Hinweis „Nicht vorrätig“ in der Liste."

#: admin/template/settings/products.php:943
msgid "Reserve stock while an item sits in a cart"
msgstr "Bestand reservieren, solange sich ein Artikel im Warenkorb befindet"

#: admin/template/settings/products.php:944
msgid ""
"Stock drops the moment a shopper adds an item, not only at purchase, and "
"returns when the reservation expires."
msgstr ""
"Der Bestand sinkt in dem Moment, in dem ein Kunde einen Artikel hinzufügt, "
"nicht erst beim Kauf, und wird wieder freigegeben, sobald die Reservierung "
"abläuft."

#: admin/template/settings/products.php:951
msgid "Reservation length"
msgstr "Reservierungsdauer"

#: admin/template/settings/products.php:952
msgid ""
"How long an item stays reserved after it is added to a cart, in the unit "
"below."
msgstr ""
"Wie lange ein Artikel nach dem Hinzufügen zum Warenkorb reserviert bleibt, "
"in der unten angegebenen Einheit."

#: admin/template/settings/products.php:962
msgid "Reservation unit"
msgstr "Reservierungseinheit"

#: admin/template/settings/products.php:963
msgid "The unit the reservation length is measured in."
msgstr "Die Einheit, in der die Reservierungsdauer gemessen wird."

#: admin/template/settings/products.php:966
msgid "Seconds"
msgstr "Sekunden"

#: admin/template/settings/products.php:967
msgid "Minutes"
msgstr "Minuten"

#: admin/template/settings/products.php:968
msgid "Hours"
msgstr "Stunden"

#: admin/template/settings/products.php:976
msgid "Put stock back when an order is cancelled"
msgstr "Bestand zurückbuchen, wenn eine Bestellung storniert wird"

#: admin/template/settings/products.php:977
msgid ""
"A cancelled order’s items go back into stock, unless the order has shipped. "
"Moving the order back to a paid status takes them again."
msgstr ""
"Die Artikel einer stornierten Bestellung gehen zurück ins Lager, sofern die "
"Bestellung nicht versandt wurde. Wird die Bestellung wieder auf einen "
"bezahlten Status gesetzt, werden sie erneut abgebucht."

#: admin/template/settings/products.php:983
msgid "Let shoppers ask for a back-in-stock email"
msgstr "Kunden können eine Benachrichtigung bei Wiederverfügbarkeit anfordern"

#: admin/template/settings/products.php:984
msgid ""
"Out-of-stock products get a “notify me” box. Subscribers are managed from "
"each product’s stock tab."
msgstr ""
"Nicht vorrätige Produkte erhalten ein Kästchen „Benachrichtigen“. Abonnenten "
"werden über den Bestands-Tab des jeweiligen Produkts verwaltet."

#: admin/template/settings/products.php:996
msgid "Customer reviews on product pages"
msgstr "Kundenbewertungen auf Produktseiten"

#: admin/template/settings/products.php:1000
msgid "Only signed-in shoppers can review"
msgstr "Nur angemeldete Kunden können bewerten"

#: admin/template/settings/products.php:1001
msgid "Guests see the reviews but must log in before writing one."
msgstr ""
"Gäste sehen die Bewertungen, müssen sich aber vor dem Schreiben einer "
"Bewertung anmelden."

#: admin/template/settings/products.php:1008
msgid "Show the reviewer’s name"
msgstr "Namen des Bewertenden anzeigen"

#: admin/template/settings/products.php:1009
msgid "Prints the name given with each review. Off shows reviews anonymously."
msgstr ""
"Zeigt den bei jeder Bewertung angegebenen Namen an. „Aus“ zeigt Bewertungen "
"anonym an."

#: admin/template/settings/products.php:1016
msgid "Email me when a review is submitted"
msgstr "Mich per E-Mail benachrichtigen, wenn eine Bewertung eingereicht wird"

#: admin/template/settings/products.php:1017
msgid "Sends a notice to the store’s admin email so you can approve it."
msgstr ""
"Sendet eine Benachrichtigung an die Admin-E-Mail-Adresse des Shops, damit "
"Sie sie freigeben können."

#: admin/template/settings/products.php:1031
msgid "Inquiry form protection"
msgstr "Schutz des Anfrageformulars"

#: admin/template/settings/products.php:1032
msgid ""
"Stops spam reaching the inquiry form on inquiry-mode products, without "
"showing shoppers a challenge"
msgstr ""
"Verhindert Spam über das Anfrageformular bei Produkten im Anfragemodus, ohne "
"Kunden eine Sicherheitsabfrage zu zeigen"

#: admin/template/settings/products.php:1036
msgid "Hidden trap field on the inquiry form"
msgstr "Verstecktes Fangfeld im Anfrageformular"

#: admin/template/settings/products.php:1037
msgid ""
"Adds a field only automated scripts can see. Anything that fills it in is "
"discarded. Shoppers never see or tab into it."
msgstr ""
"Fügt ein Feld hinzu, das nur automatisierte Skripte sehen können. Alles, was "
"es ausfüllt, wird verworfen. Kunden sehen es nie und können nicht per "
"Tabulator hineingelangen."

#: admin/template/settings/products.php:1044
msgid "Shortest time an inquiry may take to write"
msgstr "Kürzeste Zeit, die das Schreiben einer Anfrage dauern darf"

#: admin/template/settings/products.php:1045
msgid ""
"Submissions that arrive sooner than this after the page loaded are refused, "
"which is how most scripted spam behaves. Set to 0 to turn the timing check "
"off."
msgstr ""
"Einsendungen, die schneller als diese Zeit nach dem Laden der Seite "
"eingehen, werden abgelehnt, da sich die meisten automatisierten Spam-Skripte "
"so verhalten. Setzen Sie den Wert auf 0, um die Zeitprüfung zu deaktivieren."

#: admin/template/settings/products.php:1050
msgid "seconds"
msgstr "Sekunden"

#: admin/template/settings/products.php:1056
msgid "Limit how many inquiries one visitor can send"
msgstr "Begrenzen, wie viele Anfragen ein Besucher senden kann"

#: admin/template/settings/products.php:1057
msgid ""
"Counts sent inquiries for an hour at a time and refuses the rest with a "
"short message. The defaults are well above normal shopper behavior."
msgstr ""
"Zählt gesendete Anfragen jeweils für eine Stunde und lehnt die übrigen mit "
"einer kurzen Meldung ab. Die Standardwerte liegen deutlich über dem normalen "
"Kundenverhalten."

#: admin/template/settings/products.php:1064
msgid "Inquiries an hour from one internet address"
msgstr "Anfragen pro Stunde von einer Internetadresse"

#: admin/template/settings/products.php:1065
msgid ""
"Counted against a one-way hash of the address, never the address itself. Set "
"to 0 for no limit."
msgstr ""
"Wird anhand eines Einweg-Hashwerts der Adresse gezählt, nie anhand der "
"Adresse selbst. Setzen Sie den Wert auf 0 für keine Begrenzung."

#: admin/template/settings/products.php:1076
msgid "Inquiries an hour from one email address"
msgstr "Anfragen pro Stunde von einer E-Mail-Adresse"

#: admin/template/settings/products.php:1077
msgid ""
"Stops the same address being used over and over from different connections. "
"Set to 0 for no limit."
msgstr ""
"Verhindert, dass dieselbe Adresse immer wieder von unterschiedlichen "
"Verbindungen aus verwendet wird. Setzen Sie den Wert auf 0 für keine "
"Begrenzung."

#: admin/template/settings/products.php:1088
msgid "Inquiries an hour about the same product"
msgstr "Anfragen pro Stunde zum selben Produkt"

#: admin/template/settings/products.php:1089
msgid ""
"A visitor who has already asked about a product this many times is asked to "
"wait. Set to 0 for no limit."
msgstr ""
"Ein Besucher, der zu einem Produkt bereits so oft angefragt hat, wird "
"gebeten zu warten. Setzen Sie den Wert auf 0 für keine Begrenzung."

#: admin/template/settings/products.php:1100
msgid "Only signed-in shoppers can send an inquiry"
msgstr "Nur angemeldete Kunden können eine Anfrage senden"

#: admin/template/settings/products.php:1101
msgid ""
"Guests still see the form but are asked to sign in first. Off by default so "
"existing stores keep taking inquiries from anyone."
msgstr ""
"Gäste sehen das Formular weiterhin, werden jedoch zuerst zur Anmeldung "
"aufgefordert. Standardmäßig deaktiviert, damit bestehende Shops weiterhin "
"Anfragen von allen annehmen."

#: admin/template/settings/products.php:1108
msgid "Check what the message contains"
msgstr "Inhalt der Nachricht prüfen"

#: admin/template/settings/products.php:1109
msgid ""
"Applies the length, link and blocked-word rules below to the name and "
"message before anything is emailed."
msgstr ""
"Wendet die unten stehenden Regeln zu Länge, Links und gesperrten Wörtern auf "
"Name und Nachricht an, bevor etwas per E-Mail versendet wird."

#: admin/template/settings/products.php:1116
msgid "Longest inquiry message"
msgstr "Maximale Länge der Anfragenachricht"

#: admin/template/settings/products.php:1117
msgid ""
"Longer messages are refused with a note asking the shopper to shorten it. "
"Set to 0 for no limit."
msgstr ""
"Längere Nachrichten werden mit einem Hinweis abgelehnt, sie zu kürzen. "
"Setzen Sie den Wert auf 0 für keine Begrenzung."

#: admin/template/settings/products.php:1129
msgid "Most web links a message may contain"
msgstr "Maximale Anzahl an Weblinks in einer Nachricht"

#: admin/template/settings/products.php:1130
msgid ""
"Link-stuffed messages are the commonest form of form spam. 0 refuses any "
"message with a link in it; raise it if your shoppers legitimately send links."
msgstr ""
"Mit Links vollgestopfte Nachrichten sind die häufigste Form von Formular-"
"Spam. 0 lehnt jede Nachricht mit einem Link ab; erhöhen Sie den Wert, wenn "
"Ihre Kunden berechtigterweise Links senden."

#: admin/template/settings/products.php:1135
msgid "links"
msgstr "Links"

#: admin/template/settings/products.php:1142
msgid "Blocked words and domains"
msgstr "Gesperrte Wörter und Domains"

#: admin/template/settings/products.php:1143
msgid ""
"One word, phrase or domain per line. An inquiry whose name, email or message "
"contains any of them is refused. Empty by default."
msgstr ""
"Ein Wort, eine Phrase oder eine Domain pro Zeile. Eine Anfrage, deren Name, "
"E-Mail oder Nachricht eines davon enthält, wird abgelehnt. Standardmäßig "
"leer."

#: admin/template/settings/products.php:1153
msgid "Log refused inquiries"
msgstr "Abgelehnte Anfragen protokollieren"

#: admin/template/settings/products.php:1154
msgid ""
"Records the reason, the product, a masked email and a one-way reference for "
"the visitor under Settings › Log entries, so you can tell spam from a "
"shopper who hit a limit. No addresses are stored."
msgstr ""
"Erfasst den Grund, das Produkt, eine maskierte E-Mail-Adresse und eine "
"Einweg-Referenz für den Besucher unter Einstellungen › Protokolleinträge, "
"damit Sie Spam von einem Kunden unterscheiden können, der ein Limit erreicht "
"hat. Es werden keine Adressen gespeichert."

#: admin/template/settings/products.php:1166
msgid "What the storefront search widget and store search match against"
msgstr "Womit das Such-Widget und die Shop-Suche abgleichen"

#: admin/template/settings/products.php:1170
msgid "Live results while typing"
msgstr "Live-Ergebnisse während der Eingabe"

#: admin/template/settings/products.php:1171
msgid "The search widget suggests matching products as the shopper types."
msgstr ""
"Das Such-Widget schlägt passende Produkte vor, während der Kunde tippt."

#: admin/template/settings/products.php:1178
msgid "Match product titles"
msgstr "Produkttitel abgleichen"

#: admin/template/settings/products.php:1179
msgid "Applies to the search widget and the store’s own search box."
msgstr "Gilt für das Such-Widget und die eigene Suchleiste des Shops."

#: admin/template/settings/products.php:1186
msgid "Match model numbers"
msgstr "Modellnummern abgleichen"

#: admin/template/settings/products.php:1187
msgid "Shoppers can find a product by typing its model number ( SKU )."
msgstr ""
"Kunden können ein Produkt finden, indem sie dessen Modellnummer ( SKU ) "
"eingeben."

#: admin/template/settings/products.php:1194
msgid "Match manufacturer names"
msgstr "Herstellernamen abgleichen"

#: admin/template/settings/products.php:1195
msgid "Typing a brand returns everything that brand makes."
msgstr "Die Eingabe einer Marke liefert alle Produkte dieser Marke."

#: admin/template/settings/products.php:1202
msgid "Match full descriptions"
msgstr "Vollständige Beschreibungen abgleichen"

#: admin/template/settings/products.php:1203
msgid "Broader results; slower on very large catalogs."
msgstr "Breitere Ergebnisse; bei sehr großen Katalogen langsamer."

#: admin/template/settings/products.php:1210
msgid "Match short descriptions"
msgstr "Kurzbeschreibungen abgleichen"

#: admin/template/settings/products.php:1211
msgid "Also searches each product’s short description."
msgstr "Durchsucht auch die Kurzbeschreibung jedes Produkts."

#: admin/template/settings/products.php:1219
msgid "Match category names"
msgstr "Kategorienamen abgleichen"

#: admin/template/settings/products.php:1220
msgid "Typing a category name returns the products in it."
msgstr ""
"Die Eingabe eines Kategorienamens liefert die darin enthaltenen Produkte."

#: admin/template/settings/products.php:1228
msgid "Match any word instead of every word"
msgstr "Beliebiges Wort statt jedes Wort abgleichen"

#: admin/template/settings/products.php:1229
msgid ""
"Returns more results: a product matches when any word of the phrase is "
"found, not only when all of them are."
msgstr ""
"Liefert mehr Ergebnisse: Ein Produkt gilt als Treffer, wenn ein beliebiges "
"Wort der Phrase gefunden wird, nicht nur wenn alle gefunden werden."

#: admin/template/settings/products.php:1240
msgid "Import & export"
msgstr "Import & Export"

#: admin/template/settings/products.php:1241
msgid "Limits for the product CSV export"
msgstr "Grenzwerte für den Produkt-CSV-Export"

#: admin/template/settings/products.php:1245
msgid "Products per export file"
msgstr "Produkte pro Exportdatei"

#: admin/template/settings/products.php:1246
msgid ""
"Large catalogs export as several CSV files of this size. Lower it if exports "
"time out on your server."
msgstr ""
"Große Kataloge werden als mehrere CSV-Dateien dieser Größe exportiert. "
"Verringern Sie den Wert, wenn Exporte auf Ihrem Server ein Zeitlimit "
"überschreiten."

#. translators: %s: shipping zone name.
#: admin/template/settings/search-ai.php:124
#, php-format
msgid "Delivery time to %s"
msgstr "Lieferzeit nach %s"

#: admin/template/settings/search-ai.php:125
msgid ""
"Days in transit for this zone, if it differs from the delivery time above."
msgstr ""
"Tage im Versand für diese Zone, falls sie von der obigen Lieferzeit "
"abweichen."

#: admin/template/settings/search-ai.php:127
msgid "Same as above"
msgstr "Wie oben"

#: admin/template/settings/search-ai.php:139
msgid ""
"How your products appear in Google, Bing and AI assistants like ChatGPT, "
"Gemini, Perplexity and Copilot."
msgstr ""
"Wie Ihre Produkte in Google, Bing und KI-Assistenten wie ChatGPT, Gemini, "
"Perplexity und Copilot erscheinen."

#: admin/template/settings/search-ai.php:151
msgid ""
"What search engines and AI assistants can read about your store right now."
msgstr ""
"Was Suchmaschinen und KI-Assistenten derzeit über Ihren Shop lesen können."

#: admin/template/settings/search-ai.php:158
msgid "Product data"
msgstr "Produktdaten"

#: admin/template/settings/search-ai.php:159
msgid ""
"What each product page tells search engines and assistants. Barcodes are set "
"per product, on its SEO tab."
msgstr ""
"Was jede Produktseite Suchmaschinen und Assistenten mitteilt. Barcodes "
"werden pro Produkt auf dem Tab SEO festgelegt."

#: admin/template/settings/search-ai.php:164
msgid "Share product details with search engines and AI assistants"
msgstr "Produktdetails mit Suchmaschinen und KI-Assistenten teilen"

#: admin/template/settings/search-ai.php:165
msgid ""
"Adds each product's price, stock, variants, barcode and reviews to its page "
"in the format Google, Bing and AI assistants read. Turn it off only if "
"another plugin already does this."
msgstr ""
"Fügt Preis, Lagerbestand, Varianten, Barcode und Bewertungen jedes Produkts "
"in dem Format zur Produktseite hinzu, das Google, Bing und KI-Assistenten "
"lesen. Schalten Sie diese Option nur aus, wenn bereits ein anderes Plugin "
"dies übernimmt."

#: admin/template/settings/search-ai.php:172
msgid "Condition of your products"
msgstr "Zustand Ihrer Produkte"

#: admin/template/settings/search-ai.php:173
msgid "Used for every product unless its own Search & AI card says otherwise."
msgstr ""
"Wird für jedes Produkt verwendet, sofern die eigene Karte „Suche & KI“ "
"nichts anderes festlegt."

#: admin/template/settings/search-ai.php:186
msgid "Reviews to share"
msgstr "Zu teilende Bewertungen"

#: admin/template/settings/search-ai.php:187
msgid ""
"\"Rating and reviews\" shares the average and the five newest reviews. "
"Reviews are only shared with the reviewer's name when your product pages "
"show names ( Settings › Products › Reviews ); otherwise just the rating is."
msgstr ""
"„Wertung und Bewertungen“ teilt den Durchschnitt und die fünf neuesten "
"Bewertungen. Bewertungen werden nur dann mit dem Namen des Bewertenden "
"geteilt, wenn Ihre Produktseiten Namen anzeigen ( Einstellungen › Produkte › "
"Bewertungen ); andernfalls wird nur die Wertung geteilt."

#: admin/template/settings/search-ai.php:190
msgid "Rating and reviews"
msgstr "Wertung und Bewertungen"

#: admin/template/settings/search-ai.php:191
msgid "Rating only"
msgstr "Nur Wertung"

#: admin/template/settings/search-ai.php:201
msgid "Returns"
msgstr "Rücksendungen"

#: admin/template/settings/search-ai.php:202
msgid ""
"Google can show your return window next to your products, and assistants "
"answer \"can I return it?\" from this."
msgstr ""
"Google kann Ihre Rückgabefrist neben Ihren Produkten anzeigen, und "
"Assistenten beantworten daraus die Frage „Kann ich es zurückgeben?“."

#: admin/template/settings/search-ai.php:207
msgid "Do you accept returns?"
msgstr "Nehmen Sie Rücksendungen an?"

#: admin/template/settings/search-ai.php:208
msgid ""
"Shared once for your whole store. \"Not shared\" says nothing about returns."
msgstr ""
"Wird einmal für Ihren gesamten Shop geteilt. „Nicht geteilt“ sagt nichts "
"über Rücksendungen aus."

#: admin/template/settings/search-ai.php:212
msgid "Within a set time"
msgstr "Innerhalb einer festgelegten Frist"

#: admin/template/settings/search-ai.php:213
msgid "Any time"
msgstr "Jederzeit"

#: admin/template/settings/search-ai.php:214
msgid "No returns"
msgstr "Keine Rücksendungen"

#: admin/template/settings/search-ai.php:221
msgid "Return window"
msgstr "Rückgabefrist"

#: admin/template/settings/search-ai.php:222
msgid "Days after delivery."
msgstr "Tage nach der Lieferung."

#: admin/template/settings/search-ai.php:233
msgid "How customers return items"
msgstr "Wie Kunden Artikel zurücksenden"

#: admin/template/settings/search-ai.php:236
msgid "By mail"
msgstr "Per Post"

#: admin/template/settings/search-ai.php:237
msgid "In store"
msgstr "Im Geschäft"

#: admin/template/settings/search-ai.php:245
msgid "Return shipping"
msgstr "Versand der Rücksendung"

#: admin/template/settings/search-ai.php:249
msgid "Customer pays"
msgstr "Kunde zahlt"

#: admin/template/settings/search-ai.php:250
msgid "Flat fee"
msgstr "Pauschalgebühr"

#: admin/template/settings/search-ai.php:258
msgid "Return fee"
msgstr "Rücksendegebühr"

#: admin/template/settings/search-ai.php:259
msgid "In your store's currency."
msgstr "In der Währung Ihres Shops."

#: admin/template/settings/search-ai.php:272
msgid "Full refund"
msgstr "Volle Rückerstattung"

#: admin/template/settings/search-ai.php:273
msgid "Exchange"
msgstr "Umtausch"

#: admin/template/settings/search-ai.php:274
msgid "Store credit"
msgstr "Shop-Guthaben"

#: admin/template/settings/search-ai.php:282
msgid "Countries you sell to"
msgstr "Länder, in die Sie verkaufen"

#: admin/template/settings/search-ai.php:283
msgid ""
"Used for your return policy, and for shipping rates that apply everywhere. "
"Leave it empty to use the countries in your shipping zones."
msgstr ""
"Wird für Ihre Rückgabebedingungen und für Versandtarife verwendet, die "
"überall gelten. Lassen Sie das Feld leer, um die Länder Ihrer Versandzonen "
"zu verwenden."

#: admin/template/settings/search-ai.php:292
msgid "Returns page"
msgstr "Seite für Rücksendungen"

#: admin/template/settings/search-ai.php:293
msgid ""
"The page with your full return policy, linked for shoppers and assistants "
"who want the details."
msgstr ""
"Die Seite mit Ihren vollständigen Rückgabebedingungen, verlinkt für Kunden "
"und Assistenten, die die Details möchten."

#: admin/template/settings/search-ai.php:303
msgid ""
"Built from Settings › Shipping rates: change a rate there and this follows. "
"Add how long orders take."
msgstr ""
"Aus Einstellungen › Versandtarife aufgebaut: Ändern Sie dort einen Tarif, "
"folgt dies automatisch. Ergänzen Sie, wie lange Bestellungen dauern."

#: admin/template/settings/search-ai.php:310
msgid "Handling time"
msgstr "Bearbeitungszeit"

#: admin/template/settings/search-ai.php:311
msgid "Business days from order to hand-over to the carrier, like 0-1."
msgstr ""
"Werktage von der Bestellung bis zur Übergabe an den Versanddienstleister, z. "
"B. 0-1."

#: admin/template/settings/search-ai.php:321
msgid "Order cut-off time"
msgstr "Bestellschluss"

#: admin/template/settings/search-ai.php:322
msgid ""
"Orders after this time start the next business day. Uses your WordPress time "
"zone."
msgstr ""
"Bestellungen nach dieser Uhrzeit beginnen am nächsten Werktag. Verwendet die "
"Zeitzone Ihrer WordPress-Installation."

#: admin/template/settings/search-ai.php:325
msgid "No cut-off"
msgstr "Kein Bestellschluss"

#: admin/template/settings/search-ai.php:340
msgid "Delivery time"
msgstr "Lieferzeit"

#: admin/template/settings/search-ai.php:341
msgid "Days in transit once shipped, like 2-5."
msgstr "Tage unterwegs nach dem Versand, z. B. 2-5."

#: admin/template/settings/search-ai.php:356
msgid ""
"Your catalog for Google Shopping, Bing and Pinterest, kept up to date by the "
"store"
msgstr ""
"Ihr Katalog für Google Shopping, Bing und Pinterest, vom Shop auf dem "
"aktuellen Stand gehalten"

#: admin/template/settings/search-ai.php:366
msgid "New feed address"
msgstr "Neue Feed-Adresse"

#: admin/template/settings/search-ai.php:367
msgid ""
"If the address was shared by mistake. The old one stops working at once."
msgstr ""
"Falls die Adresse versehentlich weitergegeben wurde. Die alte funktioniert "
"sofort nicht mehr."

#: admin/template/settings/search-ai.php:368
msgid "New address"
msgstr "Neue Adresse"

#: admin/template/settings/search-ai.php:369
msgid "Make a new feed address?"
msgstr "Neue Feed-Adresse erstellen?"

#: admin/template/settings/search-ai.php:370
msgid ""
"The current address stops working at once. Paste the new one into Google, "
"Microsoft and Pinterest; a connected Merchant Center is moved for you."
msgstr ""
"Die aktuelle Adresse funktioniert sofort nicht mehr. Fügen Sie die neue in "
"Google, Microsoft und Pinterest ein; ein verbundenes Merchant Center wird "
"für Sie umgestellt."

#: admin/template/settings/search-ai.php:371
msgid "Make a new address"
msgstr "Neue Adresse erstellen"

#: admin/template/settings/search-ai.php:379
msgid "Feed options"
msgstr "Feed-Optionen"

#: admin/template/settings/search-ai.php:380
msgid "When the feed rebuilds and what goes in it"
msgstr "Wann der Feed neu erstellt wird und was darin enthalten ist"

#: admin/template/settings/search-ai.php:387
msgid "Build the feed every night at"
msgstr "Feed jede Nacht erstellen um"

#: admin/template/settings/search-ai.php:388
msgid ""
"Pick an hour before Google fetches it. Product and stock changes are also "
"picked up within the hour."
msgstr ""
"Wählen Sie eine Uhrzeit vor dem Abruf durch Google. Produkt- und "
"Bestandsänderungen werden außerdem innerhalb einer Stunde übernommen."

#: admin/template/settings/search-ai.php:397
msgid "Include out-of-stock products"
msgstr "Nicht vorrätige Produkte einbeziehen"

#: admin/template/settings/search-ai.php:398
msgid ""
"Google shows them as out of stock instead of dropping them, which keeps "
"their history."
msgstr ""
"Google zeigt sie als nicht vorrätig an, statt sie zu entfernen, wodurch ihr "
"Verlauf erhalten bleibt."

#: admin/template/settings/search-ai.php:405
msgid "Use your store name as the brand for handmade products"
msgstr "Shopnamen als Marke für handgefertigte Produkte verwenden"

#: admin/template/settings/search-ai.php:406
msgid ""
"For products marked \"no barcode\" that have no manufacturer, as Google asks "
"for custom goods."
msgstr ""
"Für Produkte, die als „kein Barcode“ markiert sind und keinen Hersteller "
"haben, wie Google es für individuell gefertigte Waren verlangt."

#: admin/template/settings/search-ai.php:413
msgid "Default Google product category"
msgstr "Standard-Google-Produktkategorie"

#: admin/template/settings/search-ai.php:414
msgid ""
"Optional. Used for products that don't set their own on their Google "
"Merchant card; Google can also work it out."
msgstr ""
"Optional. Wird für Produkte verwendet, die auf ihrer Karte „Google Merchant“ "
"keine eigene festlegen; Google kann sie auch selbst ermitteln."

#: admin/template/settings/search-ai.php:416
msgid "Apparel & Accessories > Clothing"
msgstr "Apparel & Accessories > Clothing"

#: admin/template/settings/search-ai.php:439
msgid "Who can read your store"
msgstr "Wer Ihren Shop lesen kann"

#: admin/template/settings/search-ai.php:440
msgid "From your robots.txt and WordPress's search engine setting."
msgstr "Aus Ihrer robots.txt und der Suchmaschineneinstellung von WordPress."

#: admin/template/settings/search-ai.php:448
msgid "After changing robots.txt or a plugin that writes it."
msgstr ""
"Nach einer Änderung der robots.txt oder eines Plugins, das sie schreibt."

#: admin/template/settings/search-ai.php:456
msgid "SEO plugin"
msgstr "SEO-Plugin"

#: admin/template/settings/search-ai.php:457
msgid "Who prints descriptions and social previews when you use an SEO plugin."
msgstr ""
"Wer Beschreibungen und Social-Media-Vorschauen ausgibt, wenn Sie ein SEO-"
"Plugin verwenden."

#: admin/template/settings/search-ai.php:463
msgid "Let the SEO plugin handle descriptions and social previews"
msgstr ""
"SEO-Plugin Beschreibungen und Social-Media-Vorschauen übernehmen lassen"

#: admin/template/settings/search-ai.php:464
msgid ""
"EasyCart stops printing its own and gives the plugin each product's "
"description and main image, so nothing is printed twice."
msgstr ""
"EasyCart gibt seine eigenen nicht mehr aus und übergibt dem Plugin die "
"Beschreibung und das Hauptbild jedes Produkts, sodass nichts doppelt "
"ausgegeben wird."

#: admin/template/settings/search-ai.php:471
msgid "Add your return and shipping policy to the SEO plugin's store details"
msgstr ""
"Rückgabe- und Versandbedingungen zu den Shop-Angaben des SEO-Plugins "
"hinzufügen"

#: admin/template/settings/search-ai.php:472
msgid ""
"Yoast SEO and Rank Math: keeps one description of your business for Google "
"instead of two."
msgstr ""
"Yoast SEO und Rank Math: Es bleibt bei einer Beschreibung Ihres Unternehmens "
"für Google statt zwei."

#: admin/template/settings/shipping-rates.php:33
msgid "How shipping is charged; only this method’s table is used at checkout"
msgstr ""
"Wie Versandkosten berechnet werden; an der Kasse wird nur die Tabelle dieser "
"Methode verwendet"

#: admin/template/settings/shipping-rates.php:54
msgid ""
"The carrier services offered when the method is live rates, in the order "
"shoppers see them"
msgstr ""
"Die angebotenen Versanddienste, wenn die Methode „Live-Tarife“ ist, in der "
"Reihenfolge, in der Kunden sie sehen"

#: admin/template/settings/shipping-rates.php:69
msgid ""
"The rate table behind your shipping method: what each option costs and where "
"it applies."
msgstr ""
"Die Tariftabelle hinter Ihrer Versandmethode: was jede Option kostet und wo "
"sie gilt."

#: admin/template/settings/shipping-settings.php:397
msgid "Static methods ( flat rates you name )"
msgstr "Statische Methoden ( von Ihnen benannte Pauschaltarife )"

#: admin/template/settings/shipping-settings.php:398
msgid "By order total"
msgstr "Nach Bestellsumme"

#: admin/template/settings/shipping-settings.php:399
