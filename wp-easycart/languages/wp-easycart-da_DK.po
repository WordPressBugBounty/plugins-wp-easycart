msgstr "Gem først begge nøgler."

#: admin/inc/wp_easycart_admin_recaptcha.php:198
msgid "Tick the reCAPTCHA box first."
msgstr "Sæt først kryds i reCAPTCHA-feltet."

#. translators: %s: the connection error.
#: admin/inc/wp_easycart_admin_recaptcha.php:212
#, php-format
msgid "Google could not be reached: %s"
msgstr "Google kunne ikke nås: %s"

#: admin/inc/wp_easycart_admin_recaptcha.php:216
