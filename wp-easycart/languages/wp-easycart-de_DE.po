msgstr ""
"Die Schutzdateien für Kunden-Uploads und kostenpflichtige Downloads wurden "
"neu geschrieben, und die Ordner wurden erneut geprüft."

#: admin/inc/wp_easycart_admin_store_status.php:242
msgid "Your post tags have been fixed."
msgstr "Ihre Post-Tags wurden korrigiert."

