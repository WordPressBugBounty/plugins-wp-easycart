msgstr "Dati dimostrativi"

#: admin/template/settings/initial-setup.php:829
msgid "Sample products, customers and orders are installed"
msgstr "I prodotti campione, i clienti e gli ordini sono installati"

#: admin/template/settings/initial-setup.php:829
msgid "Sample products and orders for trying the store out"
msgstr "Prova prodotti e ordini per provare il negozio"

