msgstr "Unbegrenzte Orte"

#: admin/inc/wp_easycart_admin_upsell.php:535
msgid "Each with hours and pickup instructions."
msgstr "Jeweils mit Öffnungszeiten und Abholanweisungen."

#: admin/inc/wp_easycart_admin_upsell.php:536
msgid "Per-location scheduling"
msgstr "Standortbezogene Terminplanung"

#: admin/inc/wp_easycart_admin_upsell.php:536
