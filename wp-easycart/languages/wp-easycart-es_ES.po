msgid "Please Select at Least One Product"
msgstr "Por favor, selecciona al menos un producto"

#: admin/inc/wp_easycart_admin_shortcodes.php:577
msgid ""
"This shortcode displays multiple products that can be selected one at a "
"time. Each is displayed with a view details button."
msgstr ""
"Este shortcode muestra varios productos que se pueden seleccionar de uno en "
