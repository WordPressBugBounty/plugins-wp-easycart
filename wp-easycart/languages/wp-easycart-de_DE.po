msgstr "Das Drucker-Symbol bei jeder Bestellung in Mein Konto."

#: admin/template/settings/documents.php:413
msgid "Print receipt link on the order confirmation page"
msgstr "Link „Quittung drucken“ auf der Bestellbestätigungsseite"

#: admin/template/settings/documents.php:414
msgid "The Print receipt button customers see right after they place an order."
msgstr ""
"Die Schaltfläche „Quittung drucken“, die Kunden direkt nach der Bestellung "
"sehen."

#: admin/template/settings/documents.php:421
msgid "Download receipt PDF"
msgstr "Quittung als PDF herunterladen"

#: admin/template/settings/documents.php:422
msgid ""
"The Invoice PDF with the Receipt heading, from the order page in My Account."
msgstr ""
"Das Rechnungs-PDF mit der Überschrift „Quittung“, von der Bestellseite in "
"Mein Konto."

#: admin/template/settings/documents.php:430
