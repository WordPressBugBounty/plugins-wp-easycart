msgstr "\"%s\" non è nel formato CODE=rate. Esempio: EUR=0,92,GBP=0,79"

#. translators: %s: the code as typed
#: admin/template/settings/initial-setup.php:343
#, php-format
msgid "“%s” is not a three-letter currency code."
msgstr "\"%s\" non è un codice valuta di tre lettere."

#. translators: %s: currency code
#: admin/template/settings/initial-setup.php:347
#, php-format
msgid "The rate for %s must be a number greater than zero."
msgstr "La tariffa per %s deve essere un numero maggiore di zero."

