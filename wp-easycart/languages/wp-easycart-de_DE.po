msgstr "Erweiterte Produkt-Tools"

#: admin/inc/wp_easycart_admin_upsell.php:556
msgid "Do more with every product"
msgstr "Mit jedem Produkt mehr erreichen"

#: admin/inc/wp_easycart_admin_upsell.php:557
msgid ""
"Variant inventory, tiered and B2B pricing, and richer galleries — all "
"managed from this list."
msgstr ""
"Variantenbestand, gestaffelte Preise und B2B-Preise sowie umfangreichere "
