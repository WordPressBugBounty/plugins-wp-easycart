msgid ""
"Product pages render with your theme's single-post template ( or a single-"
"ec_store.php file ) instead of being treated as pages."
msgstr ""
"Produktseiten werden mit der Einzelbeitragsvorlage Ihres Themes (oder einer "
"single-ec_store.php-Datei) gerendert, statt als Seiten behandelt zu werden."

#: admin/template/settings/design.php:669
msgid "Match store page meta on product pages"
msgstr "Meta-Daten der Shop-Seite auf Produktseiten übernehmen"

#: admin/template/settings/design.php:670
msgid ""
"Legacy option for older layouts that copied the store page's meta onto "
"product pages. The current design does not use it."
msgstr ""
"Ältere Option für frühere Layouts, die die Meta-Daten der Shop-Seite auf "
"Produktseiten übertragen haben. Das aktuelle Design verwendet sie nicht."

