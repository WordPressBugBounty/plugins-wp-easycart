msgstr "Secret API"

#: admin/template/settings/shipping-settings.php:619
msgid "Site ID"
msgstr "ID de site"

#: admin/template/settings/shipping-settings.php:619
msgid "From your DHL XML Services account."
msgstr "Depuis votre compte DHL XML Services."

#: admin/template/settings/shipping-settings.php:620
msgid "Site password"
msgstr "Mot de passe du site"

#: admin/template/settings/shipping-settings.php:621
#: admin/template/settings/shipping-settings.php:645
#: admin/template/settings/shipping-settings.php:688
msgid "Account number"
msgstr "Numéro de compte"

#: admin/template/settings/shipping-settings.php:621
