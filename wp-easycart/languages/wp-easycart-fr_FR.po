msgid "Terms you offer"
msgstr "Conditions que vous proposez"

#: admin/template/settings/documents.php:690
msgid "The due date is the order date plus these days; 0 means due on receipt."
msgstr ""
"La date d'échéance est la date de la commande plus ce nombre de jours ; 0 "
"signifie payable à réception."

