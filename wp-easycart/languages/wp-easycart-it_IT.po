msgstr "Importo percentuale o forfettario"

#: admin/inc/wp_easycart_admin_upsell.php:509
msgid ""
"Cap a percentage with a minimum and maximum; a negative amount becomes a "
"discount."
msgstr ""
"Limita una percentuale con un minimo e un massimo; un importo negativo "
"diventa uno sconto."

#: admin/inc/wp_easycart_admin_upsell.php:510
msgid "Charge by location"
msgstr "Addebita in base alla posizione"

#: admin/inc/wp_easycart_admin_upsell.php:510
