#: admin/inc/wp_easycart_admin_email_help.php:294
msgid "Press <b>Send a test email</b> and check the inbox."
msgstr ""
"Pulsa <b>Enviar un correo de prueba</b> y revisa la bandeja de entrada."

#. translators: 1: plugin that sends, 2: other plugins
#: admin/inc/wp_easycart_admin_email_help.php:312
#, php-format
msgid ""
"Decide which one you set up. Right now %1$s is doing the sending and %2$s is "
"not."
msgstr "Decide cuál configuras. Ahora mismo %1$s es el que envía y %2$s no."

#. translators: %s: link to the Plugins page
#: admin/inc/wp_easycart_admin_email_help.php:314
#, php-format
