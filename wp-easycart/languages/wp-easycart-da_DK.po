msgid "Checkout Form"
msgstr "Kasseformular"

#: admin/template/settings/checkout/checkout-form-settings.php:14
msgid "Country: Combo Box"
msgstr "Avanceret: kombinationsboks"

#: admin/template/settings/checkout/checkout-form-settings.php:14
msgid ""
"Display the country input as a select box and prevent user input errors "
"(preferred method)."
msgstr ""
"Vis landeinputtet som et valgfelt, og undgå brugerinputfejl (foretrukken "
"metode)."

#: admin/template/settings/checkout/checkout-form-settings.php:23
msgid "Country: Default Selection"
msgstr "Land blev slettet"

#: admin/template/settings/checkout/checkout-form-settings.php:23
msgid "If no country has been selected, it will default to this selection."
msgstr ""
"Hvis der ikke er valgt noget land, vil det som standard være dette valg."

#: admin/template/settings/checkout/checkout-form-settings.php:25
msgid "Country: Start of Form"
msgstr "Land: Starten af formularen"

#: admin/template/settings/checkout/checkout-form-settings.php:25
