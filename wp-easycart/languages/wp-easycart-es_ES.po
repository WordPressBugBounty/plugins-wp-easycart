#, php-format
msgid "Your emails are sent by %s"
msgstr "Tus correos los envía %s"

#. translators: %s: mail plugin name
#: inc/classes/core/ec_email.php:716
#, php-format
msgid ""
"Good: a dedicated mail plugin usually delivers better than your server's "
