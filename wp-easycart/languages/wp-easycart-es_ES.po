msgid "From address is on a different domain than the store"
msgstr "La dirección «de» está en un dominio distinto al de la tienda"

#: inc/classes/core/ec_email.php:698
#, php-format
msgid ""
"Mail is sent from %1$s but the store is %2$s. That is fine if you control "
"both domains and %1$s has SPF/DKIM for your sending service."
msgstr ""
"El correo se envía desde %1$s, pero la tienda es %2$s. Esto está bien si "
