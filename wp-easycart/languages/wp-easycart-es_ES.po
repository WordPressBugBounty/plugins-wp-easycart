#: inc/classes/core/ec_email.php:700
msgid "From address is on your own domain"
msgstr "La dirección «de» está en tu propio dominio"

#: inc/classes/core/ec_email.php:707
msgid "Your SMTP plugin isn't in the path"
msgstr "Tu plugin de SMTP no está en la ruta de envío"

