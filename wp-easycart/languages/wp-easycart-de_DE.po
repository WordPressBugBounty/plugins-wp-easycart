#: admin/template/settings/email-marketing.php:93
msgid ""
"Keep MailerLite, Kit or ActiveCampaign in step with your newsletter list, "
"customers, orders and abandoned carts."
msgstr ""
"Halten Sie MailerLite, Kit oder ActiveCampaign mit Ihrer Newsletter-Liste, "
