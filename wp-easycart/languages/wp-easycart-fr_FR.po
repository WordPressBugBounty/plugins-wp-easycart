msgstr "MyDHL API"

#: admin/template/settings/shipping-settings.php:615
msgid "XML Services ( older )"
msgstr "XML Services ( ancien )"

#: admin/template/settings/shipping-settings.php:615
msgid "Connection"
msgstr "Connexion"

#: admin/template/settings/shipping-settings.php:615
