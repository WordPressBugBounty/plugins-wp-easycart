msgid "TaxJar live token"
msgstr "Token de producción de TaxJar"

#: admin/template/settings/tax.php:836
msgid "From your TaxJar account. Used while sandbox mode is off."
msgstr ""
"De tu cuenta de TaxJar. Se usa mientras el modo de pruebas está desactivado."

#: admin/template/settings/tax.php:844
msgid "TaxJar sandbox token"
msgstr "Token de pruebas de TaxJar"

#: admin/template/settings/tax.php:845
msgid "From your TaxJar account. Used only while sandbox mode is on."
msgstr ""
