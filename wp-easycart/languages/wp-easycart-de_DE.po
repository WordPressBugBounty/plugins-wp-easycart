msgstr ""
"Fügen Sie dem Link Gutscheincodes hinzu, damit der Rabatt bereits beim "
"Öffnen des Warenkorbs angewendet wird."

#: admin/inc/wp_easycart_admin_upsell.php:549
msgid "Expiry dates & use limits"
msgstr "Verfallsdaten und Verwendungsbeschränkungen"

#: admin/inc/wp_easycart_admin_upsell.php:549
