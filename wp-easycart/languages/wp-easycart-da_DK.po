"When phone number is collected, you may require it or not require it using "
"this option."
msgstr ""
"Når der indsamles et telefonnummer, kan du få brug for det eller ikke kræve "
"det ved hjælp af denne indstilling."

#: admin/template/settings/checkout/checkout-form-settings.php:37
msgid "Enable this to allow customers to enter an optional company name."
msgstr ""
"Aktivér dette for at give kunderne mulighed for at angive et valgfrit "
"firmanavn."

#: admin/template/settings/checkout/checkout-form-settings.php:39
msgid "Require Company Name"
msgstr "Kræv firmanavn"

#: admin/template/settings/checkout/checkout-form-settings.php:39
msgid "Enable this to require customers to enter a company name."
msgstr "Aktivér dette for at kræve, at kunderne indtaster et firmanavn."

#: admin/template/settings/checkout/checkout-form-settings.php:41
msgid "Enabling requires businesses to enter their VAT number on checkout."
msgstr ""
"Aktivering kræver, at virksomheder indtaster deres momsnummer ved kassen."

#: admin/template/settings/checkout/checkout-form-settings.php:43
msgid "Allows customers to enter optional notes during checkout."
msgstr "Giver kunderne mulighed for at indtaste valgfrie noter ved kassen."

#: admin/template/settings/checkout/checkout-form-settings.php:45
