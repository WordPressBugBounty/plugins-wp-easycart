#: admin/inc/wp_easycart_admin_upsell.php:572
msgid "Reporting"
msgstr "Berichte"

#: admin/inc/wp_easycart_admin_upsell.php:573
msgid "See what is selling, to whom, and what you are leaving behind"
msgstr "Finden Sie heraus, was sich verkauft, an wen und was Sie verpassen"

