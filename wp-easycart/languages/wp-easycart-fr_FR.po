msgstr ""
"MyDHL API est la connexion actuelle de DHL. XML Services continue de fournir "
"des tarifs pour un Site ID existant jusqu'à ce que vous changiez."

#: admin/template/settings/shipping-settings.php:617
msgid "From the MyDHL API access DHL gives your account on developer.dhl.com."
msgstr ""
"À partir de l'accès MyDHL API que DHL accorde à votre compte sur "
"developer.dhl.com."

