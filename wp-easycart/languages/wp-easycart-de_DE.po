msgstr "Produktmodifikatoren"

#: admin/inc/wp_easycart_admin_upsell.php:563
msgid ""
"Text, number, date and file inputs, add-on checkboxes, radios and quantity "
"grids, each with its own price."
msgstr ""
"Text-, Zahlen-, Datums- und Datei-Eingaben, Zusatz-Checkboxen, Radiobuttons "
