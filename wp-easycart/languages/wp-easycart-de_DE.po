#: admin/inc/wp_easycart_admin_upsell.php:582
msgid ""
"Views, add to cart, units, sales and conversion per product, days of stock "
"left, and what has not sold in 60 days."
msgstr ""
"Aufrufe, In-den-Warenkorb-Aktionen, Stückzahlen, Umsatz und Konversion pro "
