msgstr "Asegurar"

#: inc/classes/core/class-wp-easycart-paypal-webhooks.php:958
msgid "Setting up…"
msgstr "Configurando…"

#: inc/classes/core/class-wp-easycart-paypal-webhooks.php:959
msgid "Could not reach PayPal. Try again in a moment."
msgstr "No se pudo conectar con PayPal. Inténtalo de nuevo en un momento."

#: inc/classes/core/class-wp-easycart-paypal-webhooks.php:959
msgid "Could not reach WP EasyCart Connect. Try again in a moment."
msgstr ""
"No se ha podido acceder a WP EasyCart Connect. Inténtalo de nuevo en un "
