msgid "Checkout Emails"
msgstr "Paiement des e-mails"

#: admin/template/settings/checkout/checkout-form-settings.php:5
msgid "Checkout Form"
msgstr "Formulaire de règlement"

#: admin/template/settings/checkout/checkout-form-settings.php:14
msgid "Country: Combo Box"
msgstr "Pays: Combo Box"

#: admin/template/settings/checkout/checkout-form-settings.php:14
msgid ""
"Display the country input as a select box and prevent user input errors "
"(preferred method)."
msgstr ""
"Affichez l'entrée du pays sous forme de boîte de sélection et évitez les "
"erreurs de saisie utilisateur (méthode préférée)."

#: admin/template/settings/checkout/checkout-form-settings.php:23
msgid "Country: Default Selection"
msgstr "Pays: Sélection par défaut"

#: admin/template/settings/checkout/checkout-form-settings.php:23
msgid "If no country has been selected, it will default to this selection."
msgstr ""
"Si aucun pays n'a été sélectionné, cette sélection sera définie par défaut."

#: admin/template/settings/checkout/checkout-form-settings.php:25
msgid "Country: Start of Form"
msgstr "Pays: Début du formulaire"

#: admin/template/settings/checkout/checkout-form-settings.php:25
msgid ""
"Allows customers to select state/province/territory based on country "
