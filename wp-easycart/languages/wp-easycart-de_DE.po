msgstr ""
"Sobald die Bestellung eine Rechnungsnummer hat, die Rechnung so, wie sie "
"ausgestellt wurde."

#: admin/template/settings/documents.php:439
msgid "Download packing slip"
msgstr "Lieferschein herunterladen"

#: admin/template/settings/documents.php:440
msgid "The default packing slip profile, as a PDF."
msgstr "Das Standardprofil des Lieferscheins als PDF."

#: admin/template/settings/documents.php:448
msgid "Download gift receipt"
msgstr "Geschenkbeleg herunterladen"

#: admin/template/settings/documents.php:449
