#: admin/template/settings/tax.php:1042
msgid "From your TaxJar account. Used only while sandbox mode is on."
msgstr ""
"Dal tuo account TaxJar. Usato solo quando la modalità sandbox è attiva."

#: admin/template/settings/tax.php:1052
msgid "Verify US addresses with TaxJar"
msgstr "Verifica gli indirizzi USA con TaxJar"

#: admin/template/settings/tax.php:1053
msgid "Needs a TaxJar Professional plan. Applies to US addresses only."
msgstr ""
"Richiede un piano TaxJar Professional. Si applica solo agli indirizzi USA."

#: admin/template/settings/tax.php:1063
msgid "TaxJar origin address"
msgstr "Indirizzo di origine TaxJar"

#: admin/template/settings/tax.php:1073
msgid "TaxJar origin city"
msgstr "Città di origine TaxJar"

#: admin/template/settings/tax.php:1083
msgid "TaxJar origin state"
msgstr "Stato di origine TaxJar"

#: admin/template/settings/tax.php:1084
msgid "Two-letter state or province code you ship from."
msgstr "Codice di due lettere dello stato o provincia da cui spedisci."

#: admin/template/settings/tax.php:1094
msgid "TaxJar origin ZIP"
msgstr "CAP di origine TaxJar"

#: admin/template/settings/tax.php:1095
msgid "ZIP or postal code you ship from."
msgstr "Il codice ZIP o postale da cui spedisci."

#: admin/template/settings/tax.php:1104
msgid "TaxJar origin country"
msgstr "Paese di origine TaxJar"

#: admin/template/settings/tax.php:1105
msgid "Country you ship from. Only countries TaxJar supports are listed."
msgstr ""
"Il paese da cui spedisci. Sono elencati solo i paesi supportati da TaxJar."

#: admin/template/settings/tax.php:1128 admin/template/settings/tax.php:1130
