#, php-format
msgid ""
"In wp-easycart-data/design/layout/%1$s/%2$s, replace the <script "
"type=\"application/ld+json\"> block with: if "
"( class_exists( 'wp_easycart_product_schema' ) ) "
"{ wp_easycart_product_schema::print_for( $this->product ); } ( $product in "
"the Meta template ). Until then Google keeps reading the old product data "
"from your copy."
msgstr ""
"In wp-easycart-data/design/layout/%1$s/%2$s, sostituisci il blocco <script "
"type=\"application/ld+json\"> con: if "
"( class_exists( 'wp_easycart_product_schema' ) ) { "
"wp_easycart_product_schema::print_for( $this->product ); } ( $product nel "
"template Meta ). Fino ad allora Google continua a leggere i vecchi dati del "
"prodotto dalla tua copia."

#: admin/inc/wp_easycart_admin_search_ai.php:330
msgid ""
"Shipping is off for this store ( Settings › Shipping ), so there is nothing "
"to share."
msgstr ""
"La spedizione è disattivata per questo negozio ( Impostazioni › "
"Spedizione ), quindi non c'è nulla da condividere."

#: admin/inc/wp_easycart_admin_search_ai.php:334
msgid "No shipping rates yet. Add them in Settings › Shipping rates."
msgstr ""
"Nessuna tariffa di spedizione per ora. Aggiungile in Impostazioni › Tariffe "
"di spedizione."

#: admin/inc/wp_easycart_admin_search_ai.php:338
msgid ""
"Live carrier rates change with every order, so they can't be listed. Set "
"this zone's shipping in Google Merchant Center instead."
msgstr ""
"Le tariffe dei corrieri in tempo reale cambiano a ogni ordine, quindi non "
"possono essere elencate. Imposta invece la spedizione di questa zona in "
"Google Merchant Center."

#: admin/inc/wp_easycart_admin_search_ai.php:339
msgid ""
"These rates apply everywhere. Choose the countries you sell to under Returns "
"so they can be listed."
msgstr ""
"Queste tariffe valgono ovunque. Scegli i paesi in cui vendi in Resi, così "
"possono essere elencate."

#: admin/inc/wp_easycart_admin_search_ai.php:340
msgid ""
"This zone covers part of a country outside the US, Australia and Japan, "
"which Google can't read. Set it in Google Merchant Center instead."
msgstr ""
"Questa zona copre una parte di un paese al di fuori di Stati Uniti, "
"Australia e Giappone, cosa che Google non riesce a leggere. Impostala invece "
"in Google Merchant Center."

#: admin/inc/wp_easycart_admin_search_ai.php:341
msgid ""
"A percentage of the order plus a handling fee can't be described. Set this "
"zone's shipping in Google Merchant Center instead."
msgstr ""
"Una percentuale dell'ordine più una commissione di gestione non può essere "
"descritta. Imposta invece la spedizione di questa zona in Google Merchant "
"Center."

