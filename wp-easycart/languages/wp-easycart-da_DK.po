msgstr ""
"Aktivér en obligatorisk aftaleboks for vilkår, og sørg for at tilføje dine "
"vilkårswebadresse i nedenstående betalingsmuligheder."

#: admin/template/settings/checkout/checkout-form-settings.php:47
msgid "Terms URL"
msgstr "Medlemskabs-URL"

#: admin/template/settings/checkout/checkout-form-settings.php:47
msgid ""
"Enter your full URL of your terms web page. this is something you will need "
"to setup on your website."
msgstr ""
"Indtast hele din WEBADRESSE på din termer webside. dette er noget, du bliver "
"nødt til at setup på din hjemmeside."

#: admin/template/settings/checkout/checkout-form-settings.php:49
msgid "Privacy Policy URL"
msgstr "URL til privatlivspolitikken"

#: admin/template/settings/checkout/checkout-form-settings.php:49
msgid ""
"Enter your full URL of your privacy policy web page. this is something you "
"will need to setup on your website."
msgstr ""
"Indtast hele din webadresse på din webside om beskyttelse af personlige "
"oplysninger. dette er noget, du bliver nødt til at setup på din hjemmeside."

#: admin/template/settings/checkout/checkout-form-settings.php:51
